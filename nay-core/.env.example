# Copie para .env no servidor. O .env NUNCA vai para o git.

# Banco: o mesmo naydb. O papel do nay-core lê as tabelas do sistema velho e
# só escreve em core_* (ver docs/DECISOES.md, "papel do banco").
DATABASE_URL=postgresql://nay_core:TROCAR@nay-postgres:5432/naydb
# a migração cria tabelas e views: roda com um papel que pode fazer DDL
DATABASE_URL_MIGRACAO=postgresql://nay:TROCAR@nay-postgres:5432/naydb

# Modelos (entrevista, pergunta 57). Timeout por chamada e uma retentativa.
LLM_CLASSIFICADOR=gpt-6-luna
LLM_COMPOSITOR=gpt-6-sol
LLM_RESERVA=gpt-5.6-sol
LLM_TIMEOUT_S=8
LLM_RETENTATIVAS=1
OPENAI_API_KEY=TROCAR

# Sombra: nesta entrega é sempre 1. O envio real exige migração nova.
MODO_SOMBRA=1

# Rajada: segundos sem mensagem nova antes de o turno abrir (pergunta 6).
RAJADA_SEGUNDOS=20
# Refresh das visões de imóvel (core_imovel_busca, core_imovel_dono).
REFRESH_IMOVEL_MIN=10
