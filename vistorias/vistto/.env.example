# ===== Obrigatório =====
# Domínio que aponta para a VPS (o Caddy emite o HTTPS sozinho)
DOMAIN=vistorias.seudominio.com.br
# URL pública usada nos links do laudo, QR Codes e e-mails
PUBLIC_URL=https://vistorias.seudominio.com.br
# Segredo para assinar os logins (gere com: openssl rand -hex 32)
APP_SECRET=troque-por-um-valor-aleatorio-longo

# Primeiro administrador (criado só na primeira execução)
ADMIN_NAME=Pedro Victor
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha
# Criar vistorias de demonstração na primeira execução? (true/false)
SEED_DEMO=true

APP_NAME=Vistto
PORT=3000

# ===== ClickSign (opcional — sem token roda em modo simulação) =====
# Também pode ser configurado pelo painel: Configurações > Parâmetros > Integrações
CLICKSIGN_TOKEN=
CLICKSIGN_ENV=sandbox
CLICKSIGN_WEBHOOK_SECRET=

# ===== E-mail SMTP (opcional — sem SMTP os e-mails ficam na Caixa de saída) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Imob Easy <vistorias@seudominio.com.br>"

# ===== IA (opcional — sem chave usa o extrator local de contratos) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
