{
  "name": "titacrm",
  "version": "1.0.0",
  "description": "TitaCRM - Next.js 15 with Postgres + Vercel Blob",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "icons": "node scripts/gerar-icones.mjs",
    "verificar:chat": "node scripts/simular-selecao-chat.mjs",
    "verificar:abc": "node --env-file=.env.local scripts/verificar-teste-abc.mjs",
    "verificar:webhook": "npx esbuild scripts/verificar-webhook-elementor.ts --bundle --platform=node --format=cjs --outfile=.verificar-webhook.cjs --alias:@=./src --external:pg --external:pg-native --external:@vercel/blob --external:pusher --log-level=warning && node .verificar-webhook.cjs && rm -f .verificar-webhook.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@scalar/nextjs-api-reference": "^0.9.24",
    "@vercel/blob": "^0.27.0",
    "@xyflow/react": "^12.11.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.39.0",
    "emoji-picker-react": "^4.18.0",
    "ffmpeg-static": "^5.3.0",
    "jose": "^5.9.6",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.22.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "typescript": "^5.3.3"
  }
}
