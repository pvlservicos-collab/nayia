# /etc/cron.d/nay-agentes -- mede os agentes da VPS a cada 5 min para a página Agentes do admin (11/10/2026)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5 * * * * root flock -n /run/nay-agentes.lock /root/nay-agentes/medir_agentes.sh >> /var/log/nay-agentes.log 2>&1
# o uso de recursos da VPS por função (CPU, memória e disco em %), para o painel Uso de recursos da aba Início (21/10)
*/5 * * * * root flock -n /run/nay-recursos.lock /usr/bin/python3 /root/nay-agentes/medir_recursos.py >> /var/log/nay-agentes.log 2>&1
# os modelos da API oficial, lidos de dentro do CRM (quem tem o token), para Captação > Modelos WhatsApp (12/10)
*/10 * * * * root docker exec -i crm-imobeasy node - < /root/nay-agentes/modelos_meta.js > /docker/nay-site-web/public/admin/dados/modelos.json.tmp 2>/dev/null && mv /docker/nay-site-web/public/admin/dados/modelos.json.tmp /docker/nay-site-web/public/admin/dados/modelos.json && chmod 644 /docker/nay-site-web/public/admin/dados/modelos.json
# 352: quem falou conosco pelo CRM (todas as linhas) vai para o naydb, e a junção de todas as fontes é refeita (10 em 10 min)
*/10 * * * * root docker exec nay-postgres psql -U nay -d crmdb -tA -c "COPY (SELECT regexp_replace(l.phone, '\D', '', 'g'), max(a.created_at) FROM lead_activities a JOIN leads l ON l.id = a.lead_id WHERE a.type = 'whatsapp' AND a.metadata->>'direction' = 'inbound' AND a.created_at > now() - interval '120 days' AND coalesce(l.phone, '') <> '' GROUP BY 1) TO STDOUT" | docker exec -i nay-postgres psql -U nay -d naydb -q -c "TRUNCATE privado.falou_conosco_crm_tmp" -c "COPY privado.falou_conosco_crm_tmp (telefone, ultima_em) FROM STDIN" -c "SELECT nay_falou_conosco_crm_trocar()" -c "SELECT nay_falou_conosco_atualizar()" >/dev/null 2>>/var/log/nay-agentes.log
