def _tirar_codigo_das_vagas(codigo, conn):
    """Tira um código de toda vaga onde ele estiver e devolve as
    mudanças aplicadas (lista vazia se não estava em nenhuma).

    Trabalho de banco compartilhado por liberar_vaga (VENDEU/ALUGOU) e
    remover_da_grade (TIRA/REMOVE): na tabela as duas fazem exatamente
    a mesma coisa, o que muda é só o significado pro Tel. Escrita num
    lugar só pra não divergirem sem ninguém perceber (doc 27, Parte
    4.3) -- o dia em que "vendeu" também marcar o imóvel no site, a
    diferença vai estar no handler, não aqui.
    """
    with conn.cursor() as cur:
        cur.execute(
            "SELECT id, horario, tipo_recorrencia, dias_semana, data_unica, codigos FROM vagas"
        )
        vagas = cur.fetchall()

    mudancas = liberar_codigo(vagas, codigo)
    if not mudancas:
        return mudancas  # nada a atualizar -- não commita à toa

    with conn.cursor() as cur:
        for m in mudancas:
            cur.execute(
                "UPDATE vagas SET codigos = %s WHERE id = %s",
                (m["codigos_depois"], m["vaga_id"]),
            )
    conn.commit()
    return mudancas


def _marcar_indisponivel(codigo, conn):
    """Tira o imóvel da oferta e mata o que dependia dele.

    Sem isto, `VENDEU` só limpava a grade: as buscas usam
    `coalesce(disponivel, true)` e continuavam oferecendo, o lembrete
    continuava cobrando e a entrega pendente continuava devendo.
    """
    resumo = []
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE imoveis SET disponivel = false, sincronizado_em = now() "
            " WHERE codigo::text = %s AND coalesce(disponivel, true) RETURNING codigo",
            (str(codigo),))
        if cur.fetchone():
            resumo.append("marquei como indisponível")

        cur.execute(
            "UPDATE lembrete SET estado='morto', motivo_fim='imovel saiu do mercado', "
            "atualizado_em=now() WHERE codigo = %s AND estado IN "
            "('agendado','enviado','congelado')", (str(codigo),))
        if cur.rowcount:
            resumo.append(f"cancelei {cur.rowcount} lembrete(s)")

        cur.execute(
            "UPDATE entrega_pendente SET estado='cancelada' "
            " WHERE codigo = %s AND estado='devendo'", (str(codigo),))
        if cur.rowcount:
            resumo.append(f"cancelei {cur.rowcount} entrega(s) pendente(s)")

        # Esquece o que sabia do imóvel. Conhecimento de imóvel vendido,
        # reusado depois, é pior que conhecimento nenhum: parece atual e
        # não é. Decisão do Tel em 01/09 -- "só apagar quando o imóvel não
        # estiver disponível".
        cur.execute("SELECT nay_esquecer_imovel(%s) AS n", (str(codigo),))
        n = (cur.fetchone() or {}).get("n") or 0
        if n:
            resumo.append(f"esqueci {n} informação(ões) que eu sabia dele")
    conn.commit()
    return resumo


def _imovel_para_o_aviso(codigo, conn):
    """Os dados do aviso de saída: o BANCO de base, o SITE por cima.

    O banco garante o aviso mesmo quando o anúncio já saiu do ar -- o Tel às
    vezes tira do site antes de escrever "alugado". O site, quando ainda tem o
    anúncio, é a mesma fonte do card (lê inclusive o "Incluso no Aluguel" que
    mora no comentário HTML), então o aviso bate com o card que os corretores
    viram. Página que não abre não derruba nada: fica o banco.

    `area_util` sai do banco como Decimal -- sem converter, o card diria
    "88.0m2".
    """
    with conn.cursor() as cur:
        cur.execute(
            "SELECT tipo, condominio_nome, bairro, sol, area_util, quartos, suites, "
            "       valor_aluguel, valor_venda, "
            "       extras->>'incluso no aluguel' AS incluso "
            "  FROM imoveis WHERE codigo::text = %s", (str(codigo),))
        linha = cur.fetchone() or {}

    def _num(v):
        return float(v) if v is not None else None

    imovel = {
        "codigo": str(codigo),
        "tipo": linha.get("tipo"),
        "condominio": linha.get("condominio_nome"),
        "bairro": linha.get("bairro"),
        "sol": linha.get("sol"),
        "area": int(linha["area_util"]) if linha.get("area_util") else None,
        "quartos": linha.get("quartos"),
        "suites": linha.get("suites"),
        "valor_aluguel": _num(linha.get("valor_aluguel")),
        "valor_venda": _num(linha.get("valor_venda")),
        "incluso_no_aluguel": linha.get("incluso"),
    }
    try:
        vivo = buscar_imovel(str(codigo))
    except Exception:
        vivo = None
    # dict vazio do anúncio fora do ar é TRUTHY -- sem `tipo`, a página não
    # ensinou nada e não pode apagar o que o banco sabe.
    if vivo and vivo.get("tipo"):
        for chave in ("tipo", "condominio", "bairro", "sol", "area",
                      "area_e_construida", "quartos", "suites", "valor_aluguel",
                      "valor_venda", "incluso_no_aluguel"):
            if vivo.get(chave) not in (None, ""):
                imovel[chave] = vivo[chave]
    return imovel


def _avisar_easy_que_saiu(codigo, conn, motivo):
    """Avisa no grupo Easy que o imóvel saiu do mercado.

    O Tel pediu em 09/09: "vai automaticamente postar lá no grupo e avisar os
    corretores que anunciam que não está mais disponível". São corretores que
    pegaram o imóvel para anunciar -- se ninguém avisa, eles seguem anunciando
    e levando cliente para um imóvel que não existe mais.

    O TEXTO É UM CARD RESUMIDO desde 15/09 (`montar_aviso_de_saida`). Até ali
    era a linha `smart tower itapuranga alugado cod: 5712`; o Tel pediu bairro,
    sol, metragem, quartos e valor, porque o condomínio tem vários imóveis e o
    corretor precisa reconhecer QUAL anúncio tirar do ar.

    NUNCA DERRUBA O COMANDO: a mudança no banco já aconteceu quando isto roda,
    e falhar aqui não pode fazer o Tel achar que o imóvel continua na grade.
    O que der errado vira linha na resposta, não exceção.
    """
    try:
        texto = montar_aviso_de_saida(_imovel_para_o_aviso(codigo, conn), motivo)

        grupos = [g for g in carregar_grupos_db(conn) if g.get("todas_fotos")]
        if not grupos:
            return "não achei o grupo do Easy para avisar -- ninguém foi avisado"

        avisados = 0
        for grupo in grupos:
            enviar_texto(grupo["id_grupo"], texto)
            avisados += 1
        return f'avisei no Easy: "{texto}"'
    except Exception as exc:
        return (f"NÃO consegui avisar no grupo Easy ({exc}) -- "
                f"o imóvel saiu da grade, mas os corretores que anunciam "
                f"ainda não sabem")


def _liberar_vaga(codigo, conn, motivo=None):
    mudancas = _tirar_codigo_das_vagas(codigo, conn)
    extra = _marcar_indisponivel(codigo, conn)

    if not mudancas and not extra:
        return f"{codigo} não estava em nenhuma vaga e já estava fora da oferta."

    linhas = [f"{codigo} removido de {len(mudancas)} vaga(s)." if mudancas
              else f"{codigo} não estava em nenhuma vaga."]
    linhas.extend(m["aviso"] for m in mudancas if m["aviso"])
    if extra:
        linhas.append("Também " + ", ".join(extra) + ".")

    # O aviso só sai quando o imóvel ACABOU de sair da oferta -- é o que
    # "marquei como indisponível" significa, e o UPDATE que o gera só casa uma
    # vez (`AND coalesce(disponivel, true)`). Sem essa amarra, repetir o
    # comando postaria o mesmo aviso de novo no grupo, e WhatsApp não tem
    # desfazer.
    if motivo and "marquei como indisponível" in extra:
        linhas.append(_avisar_easy_que_saiu(codigo, conn, motivo))
    return "\n".join(linhas)


def _remover_da_grade(codigo, conn):
    """Mesma escrita no banco que _liberar_vaga, resposta diferente de
    propósito: não afirma nem sugere que o imóvel foi vendido/alugado,
    porque TIRA/REMOVE é só reorganização de horário."""
    mudancas = _tirar_codigo_das_vagas(codigo, conn)
    if not mudancas:
        return f"{codigo} não estava na grade."

    linhas = [f"{codigo} removido da grade."]
    linhas.extend(m["aviso"] for m in mudancas if m["aviso"])
    return "\n".join(linhas)


# Palavras que todo condomínio tem e que não ajudam a reconhecer nenhum.
# "Parque" NÃO entra: "Condomínio Parque Imperial" sem ela vira "imperial",
# que é outro lugar. Tirar demais é pior que deixar uma palavra a mais.
_GENERICAS_DO_NOME = ("condominio", "condomínio", "residencial",
                      "edificio", "edifício", "ed.")


def _nome_curto(imovel):
    """O nome pelo qual o Tel reconhece o imóvel, do jeito que ele escreve.

    Pedido dele em 09/09, com exemplos: `2247 acquarelle 4.6k`,
    `5673 jardim das cerejeiras 3.6k`, e para imóvel de rua
    `1192 casa parque dez 5k`.

    Em condomínio, o nome do condomínio sem as palavras genéricas. Em via
    pública -- que aqui, como no card do disparo, é o imóvel SEM condomínio --
    o tipo mais o bairro.
    """
    condominio = (imovel.get("condominio_nome") or "").strip()
    if condominio:
        palavras = [p for p in condominio.split()
                    if p.lower().strip(".") not in
                    [g.strip(".") for g in _GENERICAS_DO_NOME]]
        return " ".join(palavras).lower() or condominio.lower()

    tipo = (imovel.get("tipo") or "").strip().lower() or "imóvel"
    bairro = (imovel.get("bairro") or "").strip().lower()
    return f"{tipo} {bairro}".strip()


def _valor_curto(valor):
    """4600 vira "4.6k", 900000 vira "900k", 2100000 vira "2.1M".

    O Tel pediu o "M" em 09/09: "quando o imóvel passar de 1.000.000 poderíamos
    colocar assim 1M... porque no caso dá para entender que é de milhão".
    Numa lista de nove linhas lida de relance, "2.1M" não se confunde com nada;
    "2100k" se confunde com "210k".

    Ponto e não vírgula porque foi assim que ele escreveu os exemplos. Até duas
    casas, sem zero à toa: 2750 vira "2.75k", não "2.8k" -- arredondar o
    aluguel de um imóvel na lista dele seria informação errada de graça.

    A unidade sai do valor JÁ ARREDONDADO, senão 999.999 viraria "1000k" --
    tecnicamente certo e ilegível.
    """
    if not valor:
        return None

    def _texto(n):
        return f"{n:.2f}".rstrip("0").rstrip(".")

    if round(valor / 1000, 2) >= 1000:
        return f"{_texto(valor / 1000000)}M"
    return f"{_texto(valor / 1000)}k"


def _resumo_dos_codigos(conn, codigos):
    """`{codigo: "acquarelle 4.6k"}` para os códigos pedidos.

    Lê do BANCO, não do site: são até nove códigos por listagem e ler ao vivo
    seriam nove requisições para uma lista que o Tel olha de relance. O preço
    é que imóvel cadastrado na última hora ainda não está na tabela -- e aí
    sai só o código, que é o que aparecia antes.
    """
    if not codigos:
        return {}
    with conn.cursor() as cur:
        cur.execute(
            "SELECT codigo::text AS codigo, tipo, condominio_nome, bairro, "
            "       valor_venda, valor_aluguel "
            "  FROM imoveis WHERE codigo::text = ANY(%s)", (list(codigos),))
        linhas = cur.fetchall()

    resumo = {}
    for i in linhas:
        # Quando o imóvel tem os dois, os DOIS aparecem: escolher um
        # esconderia do Tel metade do que ele está disparando.
        valores = [v for v in (_valor_curto(i["valor_venda"]), _valor_curto(i["valor_aluguel"])) if v]
        partes = [_nome_curto(i)] + ([" / ".join(valores)] if valores else [])
        resumo[i["codigo"]] = " ".join(p for p in partes if p)
    return resumo


def _perguntar_o_negocio(categoria, como_pedir):
    """"É para locação ou para venda?" -- a pergunta que ele pediu em 09/09.

    ANTES ELA SUPUNHA LOCAÇÃO. O Tel: *"quando eu mandar assim ela tem que me
    perguntar se é para venda ou locação, porque... quando pedir para venda
    ela precisa mandar também que vou precisar"*. Supor calado fazia a lista
    de venda nunca chegar, e ele não tinha como saber que faltava uma palavra.

    A pergunta traz as DUAS frases prontas, com a categoria que ele já
    escreveu, para a resposta ser um copiar e colar em vez de outra rodada de
    adivinhação. `como_pedir` é o verbo do caminho ("lista de", "dispara lista
    de") -- a mesma pergunta serve aos dois.
    """
    nome = NOME_DA_CATEGORIA.get(categoria, categoria)
    return (f'é para LOCAÇÃO ou para VENDA? Me manda '
            f'"Nay {como_pedir} {nome} para locação" ou '
            f'"Nay {como_pedir} {nome} para venda".')


def _listar_categoria(conn, categoria, negocio):
    """A lista pronta, montada no BANCO.

    A regra de formatação mora em `lista_de_imoveis.sql` e não aqui de
    propósito: é a mesma regra que a Nay vai usar quando um corretor pedir a
    lista, e regra de negócio em dois lugares diverge sozinha -- o padrão 4.3
    do HISTORICO, que já custou caro neste projeto.
    """
    if not negocio:
        return _perguntar_o_negocio(categoria, "lista de")

    with conn.cursor() as cur:
        cur.execute("SELECT texto_pronto FROM nay_lista_de_imoveis(%s, %s)",
                    (categoria, negocio))
        linha = cur.fetchone()
    return (linha or {}).get("texto_pronto") or "não consegui montar a lista."



# Quanto cabe numa mensagem de texto. MEDIDO em 09/09 contra o catálogo real:
# a lista de apartamento para LOCAÇÃO (o pedido do Tel) tem 33 itens e 1.755
# caracteres, mas a de apartamento para VENDA tem 118 itens e **6.600**, e a
# de casa em condomínio para venda tem 4.498. Uma delas sozinha estoura o
# limite de 4.096 que várias rotas de WhatsApp aplicam -- e o sintoma seria o
# pior deste projeto: o Tel escreve o comando e nada chega em grupo nenhum.
#
# 3.500 é folgado de propósito. Não medi o teto real da Z-API (medir exigiria
# postar num grupo, que não desfaz), então o número é conservador em vez de
# apertado.
LIMITE_TEXTO_WHATSAPP = 3500


def _pedacos_da_lista(texto, limite=LIMITE_TEXTO_WHATSAPP):
    """Quebra a lista em mensagens que cabem, sempre em LINHA INTEIRA.

    Cortar no meio de uma linha partiria "3 quartos sendo 1 suíte / 4.6k" em
    duas mensagens e o corretor leria valor errado. Cada pedaço depois do
    primeiro repete o título com "(continuação)", senão quem chega no meio da
    rolagem não sabe do que é a lista.
    """
    if len(texto) <= limite:
        return [texto]

    linhas = texto.split("\n")
    titulo = linhas[0]
    continuacao = f"{titulo} (continuação)"

    pedacos = []
    atual = [titulo]
    tamanho = len(titulo)
    for linha in linhas[1:]:
        if atual and tamanho + 1 + len(linha) > limite:
            pedacos.append("\n".join(atual))
            atual = [continuacao]
            tamanho = len(continuacao)
        atual.append(linha)
        tamanho += 1 + len(linha)
    if len(atual) > 1:
        pedacos.append("\n".join(atual))
    return pedacos


# As categorias de lista que são de imóvel COMERCIAL -- as que o grupo
# "🟢 Comercial" recebe. Hoje só a de sala comercial existe como lista.
CATEGORIAS_COMERCIAIS = frozenset({"sala"})


def _nome_de_lugar_na_lista(conn, texto):
    """A frase da lista nomeia um CONDOMÍNIO de verdade? Então não é lista.

    MEDIDO em 15/09: "envia as casas do morada dos pássaros para aluguel" tem
    a palavra "casas" e caía no disparo da lista INTEIRA de casas de locação,
    em todos os grupos parceiros -- por causa de uma frase que fala de UM
    condomínio. Postagem em grupo não desfaz.

    Aqui e não no parser porque só quem vê o catálogo sabe que "morada dos
    pássaros" é um condomínio e "parceiros" não é.
    """
    try:
        with conn.cursor() as cur:
            cur.execute("SELECT nay_normalizar_lugar(%s, true) AS frase", (texto,))
            frase = ((cur.fetchone() or {}).get("frase") or texto)
        return casar_condominios(frase, condominios_do_catalogo(conn))
    except Exception:
        return []


def _disparar_lista(comando, conn, pausa=time.sleep):
    """Manda a lista pronta NOS GRUPOS. Pedido do Tel em 09/09:

        Nay dispara lista de apartamento para locação   -> grupos de parceiro
        Nay dispara lista no imóveis para anunciar easy -> só o grupo do Easy

    É o MESMO texto que o `Nay lista de ...` mostra na tela -- montado pela
    mesma função do banco, para o que ele confere na tela ser o que sai.

    Quatro paredes, porque disparo em grupo não desfaz:

    1. **Sem categoria não dispara.** O segundo exemplo dele não diz qual
       lista; adivinhar mandaria a lista errada para 13 grupos.
    2. **Lista vazia não sai.** "não tenho nenhum imóvel nessa categoria"
       é resposta para ELE, não mensagem para os grupos.
    3. **Repetição trava** por `nay_reservar_disparo_de_lista` (janela em
       `config.lista_repete_minutos`), com escape se ele escrever "de novo".
       O CLAUDE.md registra que `postar_agora` não tem essa proteção e que
       reenviar posta duas vezes em 14 grupos, sem desfazer.
    4. **`aceita_locacao` é respeitado**: o grupo "SÓ TERCEIROS COMPRA, VEN"
       não recebe lista de locação. A trava é este cruzamento em código, não
       instrução de prompt -- doc 27, Parte 4.3.
    """
    categoria = comando.get("categoria")
    negocio = comando.get("negocio")
    destino = "easy" if comando.get("destino") == "easy" else "parceiros"
    no_easy = " no anunciar easy" if destino == "easy" else ""
    onde_txt = "no anunciar easy" if destino == "easy" else "nos grupos"

    if not categoria:
        return ('não disparei nada: você não disse QUAL lista. Me manda '
                f'assim: "Nay dispara lista de apartamento para locação'
                f'{no_easy}". '
                f'As categorias são: {", ".join(NOMES_DE_CATEGORIA)}.')

    # SEM NEGÓCIO NÃO DISPARA. Na lista de tela supor custaria uma pergunta a
    # mais; aqui custaria a lista errada em 13 grupos, sem desfazer.
    if not negocio:
        return ("não disparei nada: "
                + _perguntar_o_negocio(categoria, "dispara lista de")
                    .replace('para locação"', f'para locação{no_easy}"')
                    .replace('para venda"', f'para venda{no_easy}"'))

    negocio_txt = "venda" if negocio == "venda" else "locação"

    # NOMEOU UM CONDOMÍNIO? ENTÃO NÃO É A LISTA DA CATEGORIA (15/09).
    # "envia as casas do morada dos pássaros para aluguel" tem "casas" e caía
    # aqui -- a lista INTEIRA de casas de locação em todos os grupos, por uma
    # frase que fala de um condomínio só. Recusa que ensina os dois caminhos.
    lugares = _nome_de_lugar_na_lista(conn, comando.get("texto") or "")
    if lugares:
        lugar = lugares[0]
        return (f'você nomeou o {lugar}, e a lista de {NOME_DA_CATEGORIA.get(categoria, categoria)} '
                f'vai INTEIRA para os grupos -- não disparei nada.\n\n'
                f'se é para mandar os imóveis do {lugar} para alguém: '
                f'"Nay envia os imóveis do {lugar} para {negocio_txt} para <nome ou número>".\n'
                f'se é para postar nos grupos: "Nay posta o {lugar} para {negocio_txt}".\n'
                f'se era a lista mesmo, tira o nome: '
                f'"Nay dispara lista de {NOME_DA_CATEGORIA.get(categoria, categoria)} para {negocio_txt}".')

    with conn.cursor() as cur:
        cur.execute("SELECT texto_pronto, quantos FROM nay_lista_de_imoveis(%s, %s)",
                    (categoria, negocio))
        linha = cur.fetchone() or {}
    texto = linha.get("texto_pronto")
    quantos = linha.get("quantos") or 0
    if not texto or not quantos:
        return (f"não tenho nenhum imóvel dessa categoria para {negocio_txt} "
                f"no momento -- não mandei nada {onde_txt}.")

    grupos = carregar_grupos_db(conn)
    if destino == "easy":
        destinos = [g for g in grupos if g.get("todas_fotos")]
        if not destinos:
            return ("não achei o grupo do Easy (todas_fotos=true) no banco -- "
                    "não mandei nada.")
    else:
        campo = "aceita_venda" if negocio == "venda" else "aceita_locacao"
        destinos = [g for g in grupos
                    if not g.get("todas_fotos") and g.get(campo)]
        if not destinos:
            return (f"nenhum grupo de parceiro aceita {negocio_txt} -- "
                    f"não mandei nada.")

    with conn.cursor() as cur:
        cur.execute(
            "SELECT id, ja_foi_em FROM nay_reservar_disparo_de_lista(%s,%s,%s,%s)",
            (categoria, negocio, destino, bool(comando.get("de_novo"))))
        reserva = cur.fetchone() or {}
    conn.commit()  # a reserva vale JÁ -- o envio abaixo leva dezenas de segundos

    if not reserva.get("id"):
        quando = reserva["ja_foi_em"].strftime("%d/%m às %H:%M")
        return (f"essa mesma lista já saiu {onde_txt} em {quando} -- não "
                f"mandei de novo. Se for para repetir mesmo assim, escreva "
                f"\"Nay dispara lista de {categoria.replace('_', ' ')} para "
                f"{negocio_txt} de novo\".")

    pedacos = _pedacos_da_lista(texto)

    # A LISTA DE CADA GRUPO (15/09). O grupo Alto Padrão só aceita locação de
    # 6.500 em diante e venda de 1.000.000 em diante, de condomínio -- e a
    # decisão do Tel foi que ele recebe a lista FILTRADA, com o título
    # recalculado, e nada quando nenhum imóvel passa. Grupo sem regra recebe o
    # texto de sempre, sem consulta a mais. Grupos com a mesma regra
    # compartilham uma consulta só.
    por_regra = {}

    def _pedacos_do_grupo(grupo):
        # GRUPO SÓ COMERCIAL (15/09) não recebe lista residencial nenhuma. A
        # única lista comercial que existe é a de sala (que já traz loja em
        # condomínio); apartamento, casa e lote pulam o grupo e a resposta diz.
        if grupo.get("so_comercial") and categoria not in CATEGORIAS_COMERCIAIS:
            return [], 0
        piso = grupo.get("venda_minima" if negocio == "venda" else "aluguel_minimo")
        so_cond = bool(grupo.get("so_condominio"))
        if piso is None and not so_cond:
            return pedacos, quantos
        chave = (piso, so_cond)
        if chave not in por_regra:
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT texto_pronto, quantos "
                    "  FROM nay_lista_de_imoveis(%s, %s, %s, %s)",
                    (categoria, negocio, piso, so_cond))
                achado = cur.fetchone() or {}
            n = achado.get("quantos") or 0
            por_regra[chave] = ((_pedacos_da_lista(achado["texto_pronto"])
                                 if n else []), n)
        return por_regra[chave]

    enviados = []
    sem_nada = []           # grupos em que nenhum imóvel passa na regra
    filtrados = {}          # grupo -> quantos recebeu, quando diferente do total
    erro = None
    try:
        for grupo in destinos:
            seus_pedacos, seus_quantos = _pedacos_do_grupo(grupo)
            if not seus_quantos:
                sem_nada.append(grupo["nome"])
                continue
            # A pausa é ENTRE ENVIOS, não entre grupos da lista: grupo pulado
            # não conta, senão a cadência anti-banimento esperaria à toa.
            if enviados:
                pausa(PAUSA_ENTRE_GRUPOS)
            for j, pedaco in enumerate(seus_pedacos):
                if j:
                    pausa(PAUSA_ANTES_TEXTO)
                enviar_texto(grupo["id_grupo"], pedaco)
            # Só depois do envio ter dado certo de verdade -- relatar grupo
            # que não recebeu levaria a NÃO reenviar para quem ficou de fora.
            enviados.append(grupo["nome"])
            if seus_quantos != quantos:
                filtrados[grupo["nome"]] = seus_quantos
    except Exception as exc:
        erro = str(exc)

    with conn.cursor() as cur:
        if enviados:
            cur.execute("UPDATE lista_disparada SET quantos=%s, grupos=%s "
                        " WHERE id=%s", (quantos, enviados, reserva["id"]))
        else:
            # Zero grupos: a reserva travaria o comando por 30 minutos sem
            # nada ter saído. Tira a reserva para ele poder tentar de novo --
            # é o buraco que o `postar_easy` deixa aberto de propósito e que
            # aqui dá para fechar, porque nada chegou a sair.
            cur.execute("DELETE FROM lista_disparada WHERE id=%s",
                        (reserva["id"],))
    conn.commit()

    nomes = ", ".join(enviados)
    if erro and enviados:
        return (f"mandei a lista ({quantos} imóveis) em {len(enviados)} de "
                f"{len(destinos)} grupo(s) e aí falhou: {erro}. "
                f"Receberam: {nomes}. NÃO reenvie o comando -- esses "
                f"receberiam duas vezes.")
    if erro:
        return (f"não consegui mandar a lista em grupo nenhum: {erro}. "
                f"Nada saiu, pode tentar de novo.")
    em_partes = f" em {len(pedacos)} partes" if len(pedacos) > 1 else ""
    resposta = (f"lista de {quantos} imóvel(is) enviada{em_partes} em "
                f"{len(enviados)} grupo(s): {nomes}.")
    # A regra do grupo aparece na resposta: o Tel precisa saber que o Alto
    # Padrão recebeu 3 e não 27, e que num disparo sem imóvel que passe ele
    # ficou de fora -- senão parece falha.
    for nome, n in filtrados.items():
        resposta += f"\n{nome} recebeu só {n} (a regra de valor dele)."
    if sem_nada:
        resposta += ("\nnão receberam, porque nenhum imóvel da lista passa na "
                     "regra deles: " + ", ".join(sem_nada) + ".")
    return resposta



def _descrever_lista(vaga):
    """"lista de apartamento para locação (nos grupos)" -- como ela aparece
    para o Tel no `Nay VAGAS` e nas confirmações."""
    nome = NOME_DA_CATEGORIA.get(vaga.get("categoria"), vaga.get("categoria"))
    negocio = "venda" if vaga.get("negocio") == "venda" else "locação"
    onde = ("no anunciar easy" if vaga.get("destino") == "easy"
            else "nos grupos de parceiro")
    return f"lista de {nome} para {negocio} {onde}"


def _agendar_lista(comando, conn):
    """"dispara apartamentos para locação todo dia às 9h" -- a lista entra na
    grade, do mesmo jeito que um imóvel entra.

    As MESMAS duas perguntas do disparo imediato valem aqui, e por um motivo
    mais forte: uma vaga errada não erra uma vez, erra todo dia. Sem categoria
    ou sem negócio, não agenda -- pergunta.
    """
    categoria = comando.get("categoria")
    negocio = comando.get("negocio")
    if not categoria:
        return ('não agendei nada: você não disse QUAL lista. Me manda assim: '
                '"Nay dispara lista de apartamento para locação todo dia às 9h". '
                f'As categorias são: {", ".join(NOMES_DE_CATEGORIA)}.')
    if not negocio:
        return ("não agendei nada: "
                + _perguntar_o_negocio(categoria, "dispara lista de")
                    .replace('locação"', 'locação todo dia às 9h"')
                    .replace('venda"', 'venda todo dia às 9h"'))

    vaga = {"horario": comando["horario"],
            "tipo_recorrencia": comando["tipo_recorrencia"],
            "dias_semana": comando.get("dias_semana"),
            "data_unica": None,
            "categoria": categoria, "negocio": negocio,
            "destino": comando.get("destino") or "parceiros"}

    with conn.cursor() as cur:
        # ON CONFLICT sobre o índice único: repetir o comando não cria uma
        # segunda vaga igual. Sem isso ele repetiria achando que não pegou, e
        # os grupos receberiam a lista duas vezes por dia, para sempre.
        cur.execute(
            "INSERT INTO vagas (horario, tipo_recorrencia, dias_semana,"
            "                   codigos, categoria, negocio, destino) "
            "VALUES (%s, %s, %s, '{}', %s, %s, %s) "
            "ON CONFLICT DO NOTHING RETURNING id",
            (vaga["horario"], vaga["tipo_recorrencia"], vaga["dias_semana"],
             vaga["categoria"], vaga["negocio"], vaga["destino"]))
        criada = cur.fetchone()
    conn.commit()

    quando = descrever_vaga(vaga)
    if not criada:
        return (f"essa vaga já existia: {_descrever_lista(vaga)}, {quando}. "
                f"Não criei outra igual.")
    return (f"Vaga #{criada['id']} criada: {_descrever_lista(vaga)}, {quando}. "
            f"A partir de agora sai sozinha.")


def _remover_lista_da_grade(comando, conn):
    """"tira a lista de apartamento para locação". O contrário do agendar.

    Sem isto ele criaria a vaga e não teria como desfazer, e a lista sairia
    todo dia para sempre -- capacidade que falta vira promessa quebrada.
    """
    categoria = comando.get("categoria")
    if not categoria:
        return ('qual lista eu tiro da grade? Me manda assim: "Nay tira a '
                'lista de apartamento para locação". Você pode ver o que está '
                'agendado com "Nay VAGAS".')

    negocio = comando.get("negocio")
    destino = comando.get("destino") or "parceiros"
    with conn.cursor() as cur:
        # Negócio ausente aqui NÃO trava: tirar demais da grade não manda
        # nada para ninguém, e o pior que acontece é ele agendar de novo. É o
        # oposto do disparo, onde adivinhar custa 13 grupos.
        cur.execute(
            "DELETE FROM vagas"
            " WHERE categoria = %s AND destino = %s"
            "   AND (%s::text IS NULL OR negocio = %s)"
            " RETURNING id, horario, tipo_recorrencia, dias_semana,"
            "           data_unica, categoria, negocio, destino",
            (categoria, destino, negocio, negocio))
        tiradas = cur.fetchall()
    conn.commit()

    if not tiradas:
        nome = NOME_DA_CATEGORIA.get(categoria, categoria)
        return f"não havia lista de {nome} na grade."
    linhas = ["Tirei da grade:"]
    linhas.extend(f"- {_descrever_lista(v)}, {descrever_vaga(v)}"
                  for v in tiradas)
    return "\n".join(linhas)



def _marcar_taxa(codigo, conn, incluso):
    """Marca (ou desmarca) que a taxa de condomínio já está no aluguel.

    O SITE NÃO PUBLICA ISSO. Conferido no HTML inteiro do 5729 em 09/09: não
    existe nem o rótulo "Taxa de Condomínio" na página. O dado veio da
    importação de agosto, e por isso dos 182 imóveis de locação disponíveis só
    92 o têm -- os que faltam são exatamente os cadastrados depois. Sem este
    comando, todo imóvel novo sai do disparo sem o "(incluso a tx)" e o Tel
    dependeria de alguém editar o banco à mão.

    Grava a mesma chave que a importação usou (`extras -> 'incluso no
    aluguel'`), com o mesmo texto, para o card e a Nay continuarem lendo de um
    lugar só.
    """
    with conn.cursor() as cur:
        cur.execute("SELECT codigo, condominio_nome, tipo, bairro, valor_aluguel "
                    "  FROM imoveis WHERE codigo::text = %s", (str(codigo),))
        imovel = cur.fetchone()
    if not imovel:
        return (f"não achei o {codigo} no catálogo. Se você cadastrou agora, a "
                f"varredura traz em até uma hora e aí o comando funciona.")

    # Sem aluguel a marca não aparece em lugar nenhum -- o "(incluso a tx)" só
    # sai ao lado do valor de locação. Dizer "marquei" seria mentira útil.
    if not imovel.get("valor_aluguel"):
        return (f"o {codigo} não tem valor de locação no cadastro, então o "
                f"\"(incluso a tx)\" não teria onde aparecer. Confira o anúncio.")

    with conn.cursor() as cur:
        if incluso:
            cur.execute(
                "UPDATE imoveis SET extras = coalesce(extras,'{}'::jsonb) "
                "  || jsonb_build_object('incluso no aluguel','Taxa de Condomínio') "
                " WHERE codigo::text = %s", (str(codigo),))
        else:
            # Tira só a chave, não o `extras` inteiro: lá dentro moram também
            # "aceita financiamento" e "aceita permuta".
            cur.execute(
                "UPDATE imoveis SET extras = coalesce(extras,'{}'::jsonb) "
                "  - 'incluso no aluguel' WHERE codigo::text = %s", (str(codigo),))
    conn.commit()

    nome = _nome_curto(imovel)
    if incluso:
        return (f"{codigo} {nome}: marquei que a taxa de condomínio está "
                f"inclusa. O card passa a sair \"Locação: R$ "
                f"{_fmt_valor(imovel['valor_aluguel'])} (incluso a tx)\".")
    return (f"{codigo} {nome}: tirei a marca de taxa inclusa. O card volta a "
            f"sair só com o valor.")


def _listar_vagas(conn):
    with conn.cursor() as cur:
        cur.execute(
            "SELECT id, horario, tipo_recorrencia, dias_semana, data_unica, "
            "       codigos, categoria, negocio, destino "
            "FROM vagas ORDER BY horario"
        )
        vagas = cur.fetchall()

    if not vagas:
        return "Nenhuma vaga cadastrada ainda."

    todos = {c for v in vagas for c in (v["codigos"] or [])}
    resumo = _resumo_dos_codigos(conn, todos)

    linhas = ["Grade atual:"]
    for vaga in vagas:
        # Vaga de LISTA não tem código -- sem este ramo ela apareceria como
        # "vaga livre" e ele acharia que não havia nada agendado ali.
        if vaga.get("categoria"):
            linhas.append(f"- {descrever_vaga(vaga)}: {_descrever_lista(vaga)}")
            continue
        codigos = vaga["codigos"] or []
        if not codigos:
            corpo = "vaga livre"
        else:
            # Código que não está na tabela sai sozinho, sem nome inventado.
            corpo = ", ".join(
                f"{c} {resumo[c]}" if resumo.get(c) else c for c in codigos)
        linhas.append(f"- {descrever_vaga(vaga)}: {corpo}")
    return "\n".join(linhas)


def _agenda_de_visitas(conn):
    with conn.cursor() as cur:
        cur.execute(
            "SELECT id, codigo, descricao, corretor, data_hora, confirmada "
            "FROM visita WHERE data_hora > now() "
            "ORDER BY data_hora"
        )
        visitas = cur.fetchall()

    if not visitas:
        return "Nenhuma visita agendada."

    linhas = ["Agenda de visitas:"]
    hoje = datetime.datetime.now(FUSO_MANAUS).date()
    for v in visitas:
        dh = v["data_hora"]
        if hasattr(dh, "date"):
            d = dh.date()
            hora = dh.strftime("%Hh%M") if dh.hour or dh.minute else ""
        else:
            d = hoje
            hora = ""
        if d == hoje:
            dia = "HOJE"
        elif d == hoje + datetime.timedelta(days=1):
            dia = "amanhã"
        else:
            dia = d.strftime("%d/%m")
        status = "✓" if v["confirmada"] else "⏳"
        cod = f' cod:{v["codigo"]}' if v.get("codigo") else ""
        linhas.append(
            f"- {status} {dia} {hora} — {v['descricao']}{cod} "
            f"({v['corretor']})")
    return "\n".join(linhas)


def _perguntar_ao_tel(conn, acao, codigo):
    """Grava a pergunta que o "sim" dele vai responder. Uma só em aberto.

    A anterior é FECHADA como 'trocada', não deixada viva: com duas abertas,
    "sim" seria ambíguo e postaria a errada. O índice único garante uma só.
    """
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE pergunta_ao_tel SET respondida_em = now(), resposta = 'trocada' "
            " WHERE respondida_em IS NULL")
        cur.execute("INSERT INTO pergunta_ao_tel (acao, codigo) VALUES (%s, %s)",
                    (acao, str(codigo)))
    conn.commit()


def _responder_pergunta(comando, conn):
    """O "sim" ou o "não" do Tel à pergunta que ela fez.

    O PEDIDO (Tel, 14/09): "quero que poste novamente mas ela me perguntando e
    eu confirmando". Na conversa real, "Pode postar novamente" caiu no agente,
    que não sabia de qual imóvel se falava.

    A PERGUNTA É TOMADA NUM UPDATE SÓ (`... WHERE respondida_em IS NULL
    RETURNING`): dois "sim" seguidos -- ele repete achando que não pegou -- não
    postam duas vezes, porque só o primeiro acha a linha aberta.

    E NÃO RESPONDE com pendência esperando o mesmo "sim"
    (`pendencia_rascunho`): a mesma palavra dispararia duas coisas
    irreversíveis. Aí ela devolve a frase explícita, que não depende de estado.
    """
    with conn.cursor() as cur:
        cur.execute("SELECT 1 FROM pendencia_rascunho LIMIT 1")
        pendencia = cur.fetchone()
        cur.execute(
            "SELECT id, acao, codigo, nome, candidatos FROM pergunta_ao_tel "
            " WHERE respondida_em IS NULL ORDER BY id DESC LIMIT 1")
        aberta = cur.fetchone()
    if aberta and pendencia and aberta.get("acao") != "postar_por_nome":
        return ('tem uma resposta de pendência esperando seu "sim" também, então '
                'não sei a qual você respondeu. para postar de novo, escreve: '
                f'"posta no anunciar easy de novo o {aberta["codigo"]}". '
                'não postei nada.')

    # "SIM" NÃO RESPONDE A PERGUNTA DO `posta <nome>` (15/09): lá a resposta é
    # qual imóvel ou qual negócio, e um "sim" não diz nenhum dos dois. Sem esta
    # parede o "sim" CONSUMIA a pergunta aberta e ela morria em "não sei
    # responder a pergunta 'postar_por_nome'" -- ele teria que recomeçar.
    do_posta = aberta if (aberta or {}).get("acao") == "postar_por_nome" else None
    if do_posta:
        if comando["resposta"] == "nao":
            _fechar_pergunta_do_posta(conn, do_posta["id"], "nao")
            return f"ok, deixei o {do_posta['nome']} quieto. não postei nada."
        pares = [tuple(c.split(":", 1)) for c in (do_posta["candidatos"] or [])
                 if ":" in c]
        if len({l for _, l in pares}) > 1:
            return ('é para LOCAÇÃO ou para VENDA? me responde com uma das '
                    'duas palavras, ou com o código. não postei nada.')
        return ("me responde com o código do que você quer que eu poste: "
                + ", ".join(sorted({c for c, _ in pares})) + ". não postei nada.")

    with conn.cursor() as cur:
        cur.execute(
            "UPDATE pergunta_ao_tel SET respondida_em = now(), resposta = %s "
            " WHERE respondida_em IS NULL AND acao = 'repostar_easy' "
            "   AND criada_em > now() - (coalesce((SELECT valor FROM config "
            "         WHERE chave = 'pergunta_ao_tel_minutos'),'30') || ' minutes')::interval "
            " RETURNING acao, codigo",
            (comando["resposta"],))
        pergunta = cur.fetchone()
    conn.commit()

    if not pergunta:
        return "não tenho nenhuma pergunta sua esperando resposta agora. não fiz nada."
    if comando["resposta"] == "nao":
        return f"ok, não postei o {pergunta['codigo']} de novo."
    if pergunta["acao"] == "repostar_easy":
        return _postar_easy(pergunta["codigo"], conn, de_novo=True)
    return f"não sei responder a pergunta '{pergunta['acao']}'. não fiz nada."


def _desfazer_reserva_easy(conn, codigo, antes):
    """Devolve `easy_publicacoes` ao que era antes da reserva: sem linha, se
    ela nasceu agora; com a data anterior, se o "de novo" a renovou. Falha em
    silêncio -- a resposta ao Tel ("não postei nada") vale com ou sem isto."""
    try:
        with conn.cursor() as cur:
            if antes is None:
                cur.execute("DELETE FROM easy_publicacoes WHERE codigo = %s", (codigo,))
            else:
                cur.execute("UPDATE easy_publicacoes SET publicado_em = %s WHERE codigo = %s",
                            (antes, codigo))
        conn.commit()
    except Exception:
        try:
            conn.rollback()
        except Exception:
            pass


def _postar_easy(codigo, conn, de_novo=False):
    """Comando dedicado do grupo todas_fotos=true (hoje só "IMÓVEIS
    PARA ANUNCIAR EASY"), fora do fluxo normal (Mudança 2). Cada
    código só entra uma vez. Sem checagem de aceita_venda/
    aceita_locacao pro grupo Easy -- o pedido não previu esse filtro
    pra este comando, então não inventei um.

    Condição de corrida real vista em produção (25/08): a versão
    anterior fazia SELECT (checa) -> busca+envia -> INSERT (grava),
    com uma janela de segundos/minutos entre checar e gravar. Duas
    chamadas pro mesmo código nesse intervalo passavam as duas pela
    checagem e postavam as duas. Conserto: reserva o código PRIMEIRO,
    de forma atômica (INSERT ... ON CONFLICT DO NOTHING ... RETURNING)
    -- o Postgres serializa INSERTs concorrentes na mesma chave
    primária, então não existe mais janela entre checar e gravar
    quando é a mesma operação. A reserva é commitada na hora, antes de
    buscar/enviar (que pode levar minutos) -- segurar a transação
    aberta até o fim do envio trocaria "corrida" por "trava a fila
    inteira por minutos a cada chamada".

    QUANDO NADA SAIU, A RESERVA É DESFEITA (14/09): o site falhou ou não
    achou o anúncio. Antes ela ficava, e o código passava a constar como
    postado sem ter ido nada ao grupo -- o próximo pedido cairia em "já foi
    postado". Falha no ENVIO continua deixando a reserva: ali parte das
    fotos pode ter saído, e liberar convidaria a repetir no grupo.
    """
    # POSTAR DE NOVO também é reserva atômica (14/09): o `DO UPDATE ... WHERE`
    # só renova a data se a postagem anterior tiver mais de 10 minutos, e o
    # RETURNING só volta linha quando renovou. Dois "sim" seguidos, ou o comando
    # repetido, não postam duas vezes -- a mesma corrida que motivou a reserva.
    #
    # O `antes` guarda a data que o "de novo" sobrescreve: se nada sair, é ela
    # que volta. O CTE lê o retrato de ANTES do comando, que é o que se quer.
    with conn.cursor() as cur:
        if de_novo:
            cur.execute(
                "WITH anterior AS (SELECT publicado_em FROM easy_publicacoes WHERE codigo = %s) "
                "INSERT INTO easy_publicacoes (codigo) VALUES (%s) "
                "ON CONFLICT (codigo) DO UPDATE SET publicado_em = now() "
                " WHERE easy_publicacoes.publicado_em < now() - interval '10 minutes' "
                "RETURNING codigo, (SELECT publicado_em FROM anterior) AS antes",
                (codigo, codigo),
            )
        else:
            cur.execute(
                "INSERT INTO easy_publicacoes (codigo) VALUES (%s) "
                "ON CONFLICT (codigo) DO NOTHING RETURNING codigo",
                (codigo,),
            )
        reservado = cur.fetchone()

    if not reservado:
        conn.rollback()
        with conn.cursor() as cur:
            cur.execute("SELECT publicado_em FROM easy_publicacoes WHERE codigo = %s", (codigo,))
            linha = cur.fetchone()
        quando = linha["publicado_em"].astimezone(FUSO_MANAUS)
        if de_novo:
            return (f"{codigo} foi postado no Easy agora há pouco "
                    f"({quando.strftime('%Hh%M')}). não postei de novo para não repetir.")
        # A RECUSA VIRA PERGUNTA (Tel, 14/09). A frase ensina a resposta mais
        # curta primeiro, e é uma que o parser lê -- a lição do "os dois" de
        # 12/09. E nunca escreve "Código: NNNN", que o nó de fotos leria.
        _perguntar_ao_tel(conn, "repostar_easy", codigo)
        return (f"o {codigo} já foi postado no Easy em {quando.strftime('%d/%m/%Y')}. "
                'quer que eu poste de novo? responde "sim" -- ou "não".')

    conn.commit()  # reserva valendo já -- ninguém mais reserva este código
    antes = reservado.get("antes")

    try:
        imovel = buscar_imovel(codigo)
    except Exception as exc:
        _desfazer_reserva_easy(conn, codigo, antes)
        return f"{codigo}: não consegui buscar no site ({exc}). não postei nada no Easy."
    if not anuncio_encontrado(imovel):
        _desfazer_reserva_easy(conn, codigo, antes)
        return aviso_fora_do_ar("no Easy", codigo)

    grupos_easy = [g for g in carregar_grupos_db(conn) if g.get("todas_fotos")]
    if not grupos_easy:
        return f"{codigo}: nenhum grupo com todas_fotos=true configurado no banco."

    nome_imovel = imovel.get("condominio") or imovel.get("tipo") or codigo

    # Falha isolada, igual _postar_codigo faz desde o doc 29. Este laço
    # era o único caminho de envio do projeto SEM proteção: uma exceção
    # aqui subia até servidor.py, que devolve 500 e retorna ANTES de
    # avisar o Tel pelo WhatsApp -- ou seja, metade da mensagem saía no
    # grupo e ele não ficava sabendo de nada.
    #
    # O Easy é o caso mais exposto justamente por levar TODAS as fotos
    # (11 no código 2943, 6s de pausa entre cada): a janela em que a
    # Z-API pode falhar no meio é de mais de um minuto.
    grupos_atingidos = 0
    try:
        for grupo in grupos_easy:
            texto_msg = montar_mensagem(imovel, grupo)
            resultado = enviar_imovel(grupo["id_grupo"], texto_msg,
                                      _fotos_para_grupo(imovel, grupo))
            grupos_atingidos += 1  # só conta depois do envio inteiro ter dado certo
            # O EASY TAMBÉM PRECISA SER REGISTRADO (01/09). Ele era o único
            # caminho de envio que postava e esquecia: sem linha em `envios`
            # não há `message_id`, e sem `message_id` a citação não resolve.
            # A Waldyrene respondeu ao card do Smart Tower Itapuranga postado
            # aqui, escreveu "ainda disponivel", e a Nay teve que perguntar de
            # qual imóvel ela falava -- com o dado na mão e sem onde procurar.
            _registrar_publicacao(conn, codigo, grupo,
                                  id_da_mensagem((resultado or {}).get("texto")))
    except Exception as exc:
        # Deliberadamente menciona o envio PARCIAL: grupos_atingidos conta
        # só os grupos que receberam tudo, então o grupo em que falhou
        # pode ter recebido o texto e parte das fotos sem aparecer nesta
        # contagem. Dizer "0 grupos" e calar isso faria o Tel achar que
        # nada saiu, quando saiu -- e WhatsApp não tem desfazer.
        return (
            f"{codigo} ({nome_imovel}): falhei no meio do envio pro Easy -- {exc}. "
            f"{grupos_atingidos} grupo(s) receberam tudo; o grupo onde parou pode "
            f"ter recebido o texto e parte das fotos. O código segue marcado como "
            f"postado, então não sai de novo por engano -- me avise se quiser liberar."
        )

    linhas = [
        f"{codigo} ({nome_imovel}) postado no Easy, com todas as fotos, "
        f"em {len(grupos_easy)} grupo(s)."
    ]
    linhas.extend(_avisos_dados_incompletos(imovel))
    return "\n".join(linhas)


