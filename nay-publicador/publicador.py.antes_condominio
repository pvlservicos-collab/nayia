# O AVISO QUANDO O ANÚNCIO NÃO ESTÁ NO AR (Tel, 14/09): o 2944 estava
# ARQUIVADO no site, e ele só descobriu porque o card saiu vazio. Pediu que a
# Nay avise na hora, para ele consertar no site antes de postar.
#
# "deve estar", e não "está": a página pública responde o mesmo
# `/nao-encontrado` para arquivado e para código que não existe, e o servidor
# não tem login do admin. Arquivado é o caso comum; a frase diz o provável e
# o que fazer, sem afirmar o que não dá para ver.
def aviso_fora_do_ar(onde, codigo=None):
    # Sem código quando quem relata já põe "NNNN: " na frente (`_postar_agora`,
    # a grade) -- senão o Tel leria "2944: ⚠️ 2944: ...".
    prefixo = f"{codigo}: " if codigo else ""
    return (f"⚠️ {prefixo}o anúncio não está no ar no site -- deve estar arquivado. "
            f"não postei nada {onde}. publica no site e me pede de novo.")


def processar_comando(texto, conexao=None):
    comando = interpretar_comando(texto)
    acao = comando["acao"]
    # A FRASE ORIGINAL FICA DISPONÍVEL a quem precisar do catálogo para
    # decidir. O parser é puro (não vê banco) e por isso não pode saber se
    # "as casas do morada dos pássaros" nomeia um condomínio de verdade --
    # quem sabe é daqui para dentro. `setdefault` porque quem já traz o texto
    # (a recusa, o pedido sem destino) traz o dele, que é o que foi lido.
    #
    # ESTA LINHA JÁ FALTOU UMA VEZ, em 15/09: a parede do `_disparar_lista`
    # existia, o teste dela passava (chamava a função direto, com o texto no
    # dicionário) e a lista saiu nos 15 grupos assim mesmo. Testar o módulo
    # não é testar o caminho -- por isso o teste de `processar_comando`
    # abaixo dela existe.
    comando.setdefault("texto", texto)

    if acao == "nao_reconhecido":
        return _nao_reconhecido(comando["texto"])

    # Recusa não consulta nada e não escreve nada -- abrir conexão para
    # devolver uma frase pronta era gasto à toa, e escondia no teste o fato
    # de que a recusa não toca no banco.
    if acao == "envio_recusado":
        return comando["motivo"]

    fechar_ao_sair = conexao is None
    conn = conexao or db.conectar()
    try:
        if acao == "postar_agora":
            return _postar_agora(comando["codigos"], conn)
        if acao == "criar_vaga":
            return _criar_vaga(comando, conn)
        if acao == "liberar_vaga":
            return _liberar_vaga(comando["codigo"], conn,
                                 comando.get("motivo"))
        if acao == "remover_da_grade":
            return _remover_da_grade(comando["codigo"], conn)
        if acao == "listar_categoria":
            return _listar_categoria(conn, comando["categoria"],
                                     comando["negocio"])
        if acao == "disparar_lista":
            return _disparar_lista(comando, conn)
        if acao == "agendar_lista":
            return _agendar_lista(comando, conn)
        if acao == "remover_lista_da_grade":
            return _remover_lista_da_grade(comando, conn)
        if acao == "marcar_taxa":
            return _marcar_taxa(comando["codigo"], conn, comando["incluso"])
        if acao == "listar_vagas":
            return _listar_vagas(conn)
        if acao == "agenda_de_visitas":
            return _agenda_de_visitas(conn)
        if acao == "postar_easy":
            return _postar_easy(comando["codigo"], conn,
                                de_novo=comando.get("de_novo", False))
        if acao == "responder_pergunta":
            return _responder_pergunta(comando, conn)
        if acao == "agenda_incompleta":
            # Nao posta: o texto fala de agenda e algo nao foi entendido.
            # Postar em 14 grupos nao tem desfazer; perguntar custa uma frase.
            return ("entendi que e para agendar, mas nao peguei tudo. me manda "
                    "assim: Nay posta o <codigo> terca e quinta as 17h. "
                    "Nao postei nada.")
        if acao == "enviar_para_corretor":
            return _enviar_para_corretor(comando, conn)
        if acao == "enviar_sem_destino":
            return _envio_sem_destino(comando, conn)
        if acao == "postar_por_nome":
            return _postar_por_nome(comando, conn)
        if acao == "escolha_do_posta":
            return _escolha_do_posta(comando, conn)
        if acao == "enviar_lista_para_corretor":
            return _enviar_lista_para_corretor(comando, conn)
        if acao == "escolher_codigos":
            return _escolher_codigos(comando, conn)
        raise RuntimeError(f"ação desconhecida do parser: {acao}")
    finally:
        if fechar_ao_sair:
            conn.close()


def _resolver_corretor(destino, conn):
    """Descobre para quem mandar. Devolve (telefone, nome) ou (None, motivo).

    Ordem: telefone explicito -> nome exato -> primeiro nome unico.
    NUNCA resolve nome ambiguo: mandar a carteira de imoveis para o
    corretor errado nao tem desfazer, e o projeto ja trata "atender uma
    pessoa achando que e outra" como o pior resultado possivel.

    Numero nao cadastrado NAO envia: o Tel decidiu em 31/08 que ela avisa e
    ele manda cadastrar. Um digito trocado mandaria imoveis a um estranho.
    """
    bruto = (destino or "").strip()
    so_digitos = re.sub(r"[^0-9]", "", bruto)

    if len(so_digitos) >= 8:
        with conn.cursor() as cur:
            cur.execute(
                "SELECT telefone, nome FROM corretores "
                " WHERE aprovado AND ativo "
                "   AND right(regexp_replace(telefone,'[^0-9]','','g'),8) = right(%s,8)",
                (so_digitos,),
            )
            achados = cur.fetchall()
        if len(achados) == 1:
            return achados[0]["telefone"], achados[0]["nome"] or bruto
        if not achados:
            return None, (
                f"o numero {bruto} nao esta cadastrado nos corretores. me manda o "
                "nome dele que eu cadastro, ou confirma o numero. nao mandei nada."
            )
        return None, f"achei mais de um corretor com o final {so_digitos[-8:]}. me passa o nome."

    # Limpa artigos e o rotulo "corretor": "o corretor Sergio" -> "Sergio"
    nome = re.sub(r"^(o|a|os|as|pro|pra|para)\s+", "", bruto, flags=re.IGNORECASE).strip()
    nome = re.sub(r"^corretor[ae]?\s+", "", nome, flags=re.IGNORECASE).strip()
    if not nome:
        return None, "para quem eu mando? me diz o nome ou o telefone."

    with conn.cursor() as cur:
        cur.execute(
            "SELECT telefone, nome FROM corretores "
            " WHERE aprovado AND ativo AND coalesce(nome,'') <> '' "
            "   AND (lower(unaccent(nome)) = lower(unaccent(%s)) "
            "        OR lower(unaccent(split_part(btrim(nome),' ',1))) = lower(unaccent(%s)))",
            (nome, nome),
        )
        achados = cur.fetchall()

    if len(achados) == 1:
        return achados[0]["telefone"], achados[0]["nome"]
    if not achados:
        return None, (
            f"nao achei corretor chamado {nome}. me manda o telefone dele que eu "
            "cadastro e ja envio."
        )
    nomes = ", ".join(a["nome"] for a in achados[:4])
    return None, f"tem mais de um {nome}: {nomes}. qual deles? pode me mandar o telefone."


def _enviar_para_corretor(comando, conn):
    """Manda card e TODAS as fotos de cada imovel para um corretor.

    O Tel decidiu em 31/08: quando ele pede, vai o texto e todas as fotos.
    Este envio nao conta no teto de uma mensagem por dia -- quem pediu foi
    ele, nao e cobranca da Nay.
    """
    # SEM CÓDIGO, COM DESCRIÇÃO: "envia toda as casas que temos para locação
    # até 4.200 para corretora Flavia Soares 92 9131-8844" (Tel, 14/09). Vai
    # pelo MESMO caminho da lista colada, que já sabe resolver no catálogo,
    # perguntar quando não fecha e segurar tudo até ele responder. Dois
    # caminhos para "descobrir o imóvel e mandar" divergiriam na primeira
    # edição -- e o que diverge é quando ela pergunta e quando manda.
    if not comando.get("codigos") and (comando.get("pedido") or "").strip():
        return _enviar_lista_para_corretor(
            {"destino": comando["destino"], "nome_dito": comando.get("nome_dito"),
             "linhas": [comando["pedido"]]}, conn)

    telefone, nome, aviso = _destinatario(conn, comando)
    if telefone is None:
        return nome  # aqui `nome` carrega o motivo da recusa

    codigos = comando.get("codigos") or []
    if not codigos:
        return (
            f"nao entendi qual imovel mandar para {nome}. me passa o codigo, ou "
            "diga o condominio e se e venda ou locacao."
        )

    return aviso + _mandar_os_codigos(conn, telefone, nome, codigos)


def _destinatario(conn, comando):
    """(telefone, nome, aviso) -- ou (None, motivo, "") quando não dá para mandar.

    CADASTRA QUEM JÁ CONVERSOU. A regra de 31/08 é não mandar para número fora
    do cadastro, e o motivo dela é o DÍGITO TROCADO: imóvel indo para um
    estranho. Em 14/09 o Tel pediu envio para a Flávia Soares, que não estava
    em `corretores` mas já tinha mandado 56 mensagens para a Nay por aquele
    número -- o risco que a regra existe para evitar não estava lá. Eu cadastrei
    à mão, e ele pediu que a Nay faça o mesmo.

    Então só entra quem o próprio número já provou existir (mensagem RECEBIDA
    dele). Número sem histórico continua recusado, como sempre.

    E QUEM JÁ ESTÁ NA TABELA, DESATIVADO, NÃO É REATIVADO: aí alguém decidiu
    tirar, e passar por cima disso por causa de um pedido de envio seria
    desfazer a decisão calado.
    """
    telefone, nome = _resolver_corretor(comando["destino"], conn)
    if telefone is not None:
        return telefone, nome, ""
    novo = _cadastrar_quem_ja_conversou(conn, comando["destino"],
                                        comando.get("nome_dito"))
    if not novo:
        return None, nome, ""
    return novo[0], novo[1], (
        f"({novo[1]} não estava no cadastro de corretores. cadastrei agora -- "
        "esse número já conversou com a Nay.)\n\n")


def _cadastrar_quem_ja_conversou(conn, destino, nome_dito):
    digitos = re.sub(r"[^0-9]", "", destino or "")
    if len(digitos) < 10:
        return None
    with conn.cursor() as cur:
        cur.execute(
            "SELECT 1 FROM corretores "
            " WHERE right(regexp_replace(telefone,'[^0-9]','','g'),8) = right(%s,8)",
            (digitos,))
        if cur.fetchone():
            return None
        cur.execute(
            "SELECT telefone, nome FROM mensagens "
            " WHERE direcao = 'recebida' AND telefone NOT LIKE '%%@lid' "
            "   AND right(regexp_replace(telefone,'[^0-9]','','g'),8) = right(%s,8) "
            " ORDER BY id DESC LIMIT 1", (digitos,))
        visto = cur.fetchone()
    if not visto:
        return None
    nome = (nome_dito or visto.get("nome") or "").strip() or None
    # O nome que ELE DIGITOU é `manual`: sem isso a sincronização de cada
    # mensagem troca "Flávia Soares" pelo nome de perfil dela na primeira
    # mensagem seguinte -- e a `nome_origem` existe justamente para separar os
    # dois (nome_do_whatsapp.sql).
    with conn.cursor() as cur:
        cur.execute(
            "INSERT INTO corretores (telefone, nome, aprovado, ativo, origem, nome_origem) "
            "VALUES (%s, %s, true, true, 'cadastrado pelo Tel ao pedir envio', %s) "
            "ON CONFLICT (telefone) DO NOTHING RETURNING telefone, nome",
            (visto["telefone"], nome, "manual" if nome_dito else "whatsapp"))
        linha = cur.fetchone()
    conn.commit()
    return (linha["telefone"], linha["nome"] or visto["telefone"]) if linha else None


def _saudacao(agora):
    """"bom dia" / "boa tarde" / "boa noite" pela hora de MANAUS.

    O fuso e explicito porque o servidor roda em UTC: as 22h de Manaus ja sao
    02h em UTC, e a saudacao sairia "bom dia" para quem esta de noite. E o
    mesmo tropeco que a agenda de visitas teve em 11/09.
    """
    h = agora.astimezone(FUSO_MANAUS).hour
    if h < 12:
        return "bom dia"
    if h < 18:
        return "boa tarde"
    return "boa noite"


def _falou_com_ela_hoje(conn, telefone):
    """Ja houve conversa com esta pessoa HOJE?

    O PEDIDO (Tel, 23/09): mandando o mesmo imovel para duas corretoras, ele
    separou os casos -- "o da Geina ela ja esta em contato entao ela tem que
    mandar normal o imovel, mas no segundo ... nao foi falado nada de mensagem
    no dia, entao ela manda: oi boa tarde! segue a opcao de imovel que fiquei
    de te enviar".

    Card caindo do nada e o que ele ja tinha reclamado em 31/08. Chegar SEM
    cumprimento no meio de uma conversa viva e o problema oposto, e os dois
    incomodam.

    O DIA E O DE MANAUS, nao o do servidor (que roda em UTC): entre 20h e
    meia-noite daqui, `current_date` la ja virou, e quem acabou de falar com
    ela seria tratado como quem sumiu ha dias.
    """
    with conn.cursor() as cur:
        cur.execute(
            "SELECT 1 FROM mensagens "
            " WHERE right(regexp_replace(telefone,'[^0-9]','','g'),8) = right(%s,8) "
            "   AND (criada_em AT TIME ZONE 'America/Manaus')::date "
            "     = (now() AT TIME ZONE 'America/Manaus')::date "
            " LIMIT 1",
            (re.sub(r"[^0-9]", "", telefone or ""),))
        return cur.fetchone() is not None


def _mandar_os_codigos(conn, telefone, nome, codigos):
    """O laco de envio: card e TODAS as fotos, um imovel por vez.

    UM LUGAR SO, porque agora sao DOIS caminhos que chegam aqui -- o envio
    por codigo ("Nay manda o 5750 pro Sergio") e o envio por LISTA colada
    (11/09). Dois lacos de envio lado a lado divergiriam na primeira edicao,
    e o que diverge aqui e a protecao contra reenvio.
    """
    # Uma linha ANTES, dizendo o que vem. O Tel apontou em 31/08 que os
    # imoveis chegaram ao Gustavo sem nenhuma palavra em volta -- card e
    # foto caindo do nada. Ele escreveu a frase que queria ver:
    # "Gustavo segue as opcoes que fiquei de te enviar".
    primeiro_nome = (nome or "").split()[0] if (nome or "").strip() else ""
    # NOME QUE É TELEFONE NÃO É NOME (15/09). Corretor cadastrado sem nome faz
    # `_resolver_corretor` devolver o próprio número digitado no lugar do nome,
    # e a abertura saía "92, segue as opções..." -- pego antes de mandar para o
    # 92 8113-3331, que está em `corretores` sem nome. Sem letra, sem vocativo.
    if not any(ch.isalpha() for ch in primeiro_nome):
        primeiro_nome = ""
    quantos = len(codigos)
    # QUEM NAO FALOU COM ELA HOJE RECEBE SAUDACAO (Tel, 23/09). Para quem esta
    # no meio de uma conversa, cumprimentar de novo soa telegrama; para quem
    # nao fala com ela ha dias, o card caindo sem uma palavra e o que ele ja
    # tinha reclamado em 31/08.
    abertura = ""
    try:
        if not _falou_com_ela_hoje(conn, telefone):
            abertura = "oi, " + _saudacao(datetime.datetime.now(FUSO_MANAUS)) + "! "
    except Exception:
        pass          # sem saber, nao cumprimenta -- e o de sempre
    try:
        enviar_texto(
            telefone,
            abertura
            + (f"{primeiro_nome}, segue" if primeiro_nome and not abertura
               else "segue")
            + (" as opções que fiquei de te enviar" if quantos > 1
               else " o imóvel que fiquei de te enviar")
            + " 👇"
        )
    except Exception:
        pass  # a frase e cortesia; sem ela o envio continua valendo

    linhas, enviados = [], 0
    for codigo in codigos:
        try:
            imovel = buscar_imovel(codigo)
        except Exception as exc:
            linhas.append(f"{codigo}: nao consegui buscar no site ({exc})")
            continue
        # PÁGINA VAZIA É "NÃO ACHEI", não imóvel -- o corretor recebia
        # "📍 Imóvel 4 / Código: 4" sem foto (14/09). Ver `anuncio_encontrado`.
        if not anuncio_encontrado(imovel):
            linhas.append(f"{codigo}: nao achei esse codigo no site")
            continue

        # NAO reenvia o que ele ja recebeu nas ultimas 12h. O 3495 saiu duas
        # vezes para o Gustavo em 31/08 porque nada olhava `envios` antes.
        # Doze horas, e nao "nunca": reenviar dias depois e legitimo, ele
        # pode ter perdido no meio da conversa.
        with conn.cursor() as cur:
            cur.execute(
                "SELECT 1 FROM envios WHERE codigo = %s AND destino = 'corretor' "
                "  AND right(regexp_replace(telefone,'[^0-9]','','g'),8) = right(%s,8) "
                "  AND enviado_em > now() - interval '12 hours' LIMIT 1",
                (str(codigo), re.sub(r"[^0-9]", "", telefone)),
            )
            if cur.fetchone():
                linhas.append(f"{codigo}: ja mandei para ele hoje, nao repeti")
                continue

        texto_msg = montar_mensagem(imovel, {"aceita_venda": True, "aceita_locacao": True})
        fotos = [f for f in (imovel.get("fotos") or []) if f]
        try:
            resultado = enviar_imovel(telefone, texto_msg, fotos)
        except Exception as exc:
            linhas.append(f"{codigo}: falhou no envio ({exc})")
            continue

        enviados += 1
        # O ID do TEXTO, que é o card -- é ele que o corretor marca ao
        # responder, não a foto.
        _registrar_envio_corretor(conn, codigo, telefone,
                                  id_da_mensagem((resultado or {}).get("texto")))
        linhas.append(f"{codigo} ({imovel.get('condominio') or imovel.get('tipo')}): "
                      f"enviado com {len(fotos)} foto(s)")

    cabecalho = (f"mandei {enviados} imovel(is) para {nome}:" if enviados
                 else f"nao consegui mandar nada para {nome}:")
    return cabecalho + "\n" + "\n".join(linhas)


