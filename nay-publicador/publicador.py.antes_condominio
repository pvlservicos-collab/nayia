    Nunca derruba o envio: a mensagem já saiu quando isto roda, e falhar
    aqui não pode fazer o chamador achar que o envio falhou.
    """
    if conn is None:
        return
    try:
        with conn.cursor() as cur:
            cur.execute(
                "INSERT INTO envios (codigo, telefone, destino, grupo_nome, message_id) "
                "VALUES (%s, %s, 'grupo', %s, %s)",
                (str(codigo), str(grupo.get("id_grupo", "")), grupo.get("nome"),
                 message_id),
            )
        conn.commit()
    except Exception:
        try:
            conn.rollback()
        except Exception:
            pass


def _so_esse_negocio(imovel, negocio):
    """O mesmo imóvel, visto por um lado só.

    "posta o jardim das cerejeiras para locação" em um imóvel que tem venda E
    locação tem que sair como card de LOCAÇÃO. Em vez de ensinar o negócio a
    cada peça do caminho (destinos, card, fotos), some com o valor do outro
    lado: `negocios_do_grupo` -- a regra única que decide grupo e card --
    passa a enxergar um imóvel de um negócio só, e tudo o mais segue igual.
    """
    if negocio not in ("venda", "locacao"):
        return imovel
    copia = dict(imovel)
    copia["valor_venda" if negocio == "locacao" else "valor_aluguel"] = None
    return copia


def _postar_codigo(codigo, grupos, conn=None, negocio=None):
    """Busca um código no site e posta em cada grupo elegível.

    Devolve um dict com o resultado estruturado (sucesso, quantos
    grupos, avisos, ou o erro) -- usado tanto por _postar_agora (comando
    imediato) quanto por disparar_grade.py (vaga agendada), pra não
    duplicar a lógica de buscar + decidir destinos + montar mensagem por
    grupo + enviar em dois lugares (doc 27, Parte 4.3).

    Falha isolada por código: um problema em buscar_imovel ou em
    enviar_imovel vira um resultado de erro, nunca uma exceção que sobe
    -- quem chama para vários códigos (postar_agora, uma vaga com mais
    de 1 código) precisa que a falha de um não trave os outros.
    """
    try:
        imovel = buscar_imovel(codigo)
    except Exception as exc:
        return {
            "codigo": codigo, "sucesso": False, "grupos_atingidos": 0,
            "erro": f"não consegui buscar no site ({exc})", "avisos": [],
        }
    # Sem isto a página vazia caía em "nenhum grupo elegível (sem valor de
    # venda nem de locação)" -- recusava, mas mandava o Tel procurar valor num
    # imóvel que não existe.
    if not anuncio_encontrado(imovel):
        return {
            "codigo": codigo, "sucesso": False, "grupos_atingidos": 0,
            "erro": aviso_fora_do_ar("nos grupos"), "avisos": [],
        }

    imovel = _so_esse_negocio(imovel, negocio)
    destinos = montar_lista_destinos(imovel, grupos)
    if not destinos:
        if negocio:
            lado = "locação" if negocio == "locacao" else "venda"
            return {
                "codigo": codigo, "sucesso": False, "grupos_atingidos": 0,
                "erro": f"não tem valor de {lado} nesse imóvel (ou nenhum "
                        f"grupo aceita {lado} nessa faixa)", "avisos": [],
            }
        return {
            "codigo": codigo, "sucesso": False, "grupos_atingidos": 0,
            "erro": "nenhum grupo elegível (sem valor de venda nem de locação)",
            "avisos": [],
        }

    nome_imovel = imovel.get("condominio") or imovel.get("tipo") or codigo
    grupos_atingidos = 0
    try:
        for grupo in destinos:
            texto_msg = montar_mensagem(imovel, grupo)
            resultado = enviar_imovel(grupo["id_grupo"], texto_msg,
                                      _fotos_para_grupo(imovel, grupo))
            grupos_atingidos += 1  # só conta depois do envio ter dado certo de verdade
            # É o card do GRUPO que o corretor marca e traz para o privado
            # -- foi exatamente isso que o Victor fez em 01/09.
            _registrar_publicacao(conn, codigo, grupo,
                                  id_da_mensagem((resultado or {}).get("texto")))
    except Exception as exc:
        # grupos_atingidos já reflete quantos ENVIOS DE VERDADE aconteceram
        # antes da falha -- zerar isso aqui seria relatar errado e podia
        # levar a reenviar pros grupos que já tinham recebido.
        return {
            "codigo": codigo, "sucesso": False, "grupos_atingidos": grupos_atingidos,
            "nome_imovel": nome_imovel,
            "erro": f"falha ao enviar ({exc})", "avisos": [],
        }

    return {
        "codigo": codigo, "sucesso": True,
        "grupos_atingidos": grupos_atingidos,
        "nome_imovel": nome_imovel,
        "erro": None, "avisos": _avisos_dados_incompletos(imovel),
    }


def _postar_agora(codigos, conn, negocio=None):
    grupos = carregar_grupos_db(conn)
    linhas = []
    for codigo in codigos:
        r = _postar_codigo(codigo, grupos, conn, negocio)
        if r["sucesso"]:
            linhas.append(f"{r['codigo']} ({r['nome_imovel']}): postado em {r['grupos_atingidos']} grupo(s)")
            linhas.extend(r["avisos"])
        elif r["grupos_atingidos"] > 0:
            linhas.append(
                f"{r['codigo']} ({r['nome_imovel']}): postado em {r['grupos_atingidos']} "
                f"grupo(s) antes de falhar -- {r['erro']}"
            )
        else:
            linhas.append(f"{r['codigo']}: {r['erro']}")

    return "Pronto:\n" + "\n".join(linhas)


def _abrir_pergunta_do_posta(conn, nome, candidatos, negocio):
    """Guarda a pergunta e devolve se havia outra aberta.

    UMA SÓ EM ABERTO (índice único): com duas, "locação" seria ambíguo e ela
    postaria o imóvel da pergunta passada -- em 14 grupos, sem desfazer.
    """
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE pergunta_ao_tel SET respondida_em = now(), resposta = 'trocada' "
            " WHERE respondida_em IS NULL RETURNING id")
        anterior = cur.fetchone()
        cur.execute(
            "INSERT INTO pergunta_ao_tel (acao, nome, candidatos, negocio) "
            "VALUES ('postar_por_nome', %s, %s, %s)",
            (nome, candidatos, negocio))
    conn.commit()
    return bool(anterior)


def _linha_da_opcao(imovel, negocio):
    """Uma opção da pergunta: código, o que é e quanto custa."""
    linha = imovel["linha_venda"] if negocio == "venda" else imovel["linha_locacao"]
    lado = "venda" if negocio == "venda" else "locação"
    return f"{imovel['codigo']} -- {linha} ({lado})"


def _opcoes_dos_candidatos(imoveis, negocio):
    """(linhas para ele ler, [(codigo, negocio)]) -- uma opção por NEGÓCIO.

    O imóvel que tem venda E locação aparece DUAS vezes de propósito: são dois
    cards diferentes, e é escolhendo um deles que ele responde as duas
    perguntas de uma vez (qual imóvel e qual negócio)."""
    linhas, pares = [], []
    for im in imoveis:
        for lado in ("locacao", "venda"):
            if negocio and lado != negocio:
                continue
            if not im["valor_aluguel" if lado == "locacao" else "valor_venda"]:
                continue
            linhas.append(_linha_da_opcao(im, lado))
            pares.append((im["codigo"], lado))
    return linhas, pares


def _imoveis_do_condominio(conn, nomes, negocio=None):
    """Os imóveis NOSSOS e NO AR desses condomínios, com o que a pergunta
    precisa mostrar: a linha da lista de cada lado e os dois valores."""
    filtros = ["nay_condominio_de_verdade(i.tipo, i.condominio_nome) = ANY(%s)"]
    params = [nomes]
    if negocio == "locacao":
        filtros.append("coalesce(i.valor_aluguel,0) > 0")
    elif negocio == "venda":
        filtros.append("coalesce(i.valor_venda,0) > 0")
    with conn.cursor() as cur:
        cur.execute(
            "SELECT i.codigo::text AS codigo, "
            "       nay_esta_no_mercado(i.disponivel, i.bloqueado, i.publicado_no_site) AS no_ar, "
            "       coalesce(i.e_parceiro,false) AS parceiro, "
            "       i.valor_aluguel, i.valor_venda, "
            "       nay_custo_cheio(i.codigo::text,'locacao') AS cheio_locacao, "
            "       nay_linha_da_lista(i.codigo::text, "
            "         nay_categoria_do_imovel(i.tipo, i.condominio_nome), 'locacao') AS linha_locacao, "
            "       nay_linha_da_lista(i.codigo::text, "
            "         nay_categoria_do_imovel(i.tipo, i.condominio_nome), 'venda') AS linha_venda "
            "  FROM imoveis i WHERE " + " AND ".join(filtros) +
            " ORDER BY coalesce(i.valor_aluguel, i.valor_venda), i.codigo", params)
        todos = cur.fetchall()
    return todos


def _postar_por_nome(comando, conn):
    """"Posta o jardim das cerejeiras" -- o imóvel pelo NOME (Tel, 15/09).

    Ele: *"eu nunca lembro por código e preciso que neste caso quando eu pedir
    pelo nome do condomínio, ela procure e me pergunte se é para venda ou
    locação"*.

    PERGUNTA SEMPRE QUE ELE NÃO DISSE O NEGÓCIO, que foi o pedido literal --
    e é também a regra desta casa: postagem em 14 grupos não tem desfazer, e
    perguntar custa uma frase. Com mais de um imóvel, a pergunta mostra código
    e valor, que é como ele pediu para escolher.
    """
    nome = (comando.get("nome") or "").strip()
    negocio = comando.get("negocio")
    # Pelo BANCO, como o pedido descrito: "parque dez" vira "parque 10", que é
    # como a chave do condomínio está guardada.
    with conn.cursor() as cur:
        cur.execute("SELECT nay_normalizar_lugar(%s, true) AS frase", (nome,))
        frase = ((cur.fetchone() or {}).get("frase") or nome)
    nomes = casar_condominios(frase, condominios_do_catalogo(conn))
    if not nomes:
        return (f'não achei condomínio com o nome "{nome}". me manda o código '
                "do imóvel, ou o nome como está no cadastro. não postei nada."
                + _parecidos_com(conn, nome))

    imoveis = _imoveis_do_condominio(conn, nomes, negocio)
    nossos = [i for i in imoveis if i["no_ar"] and not i["parceiro"]]
    if not nossos:
        fora = [i["codigo"] for i in imoveis if not i["no_ar"] and not i["parceiro"]]
        parc = [i["codigo"] for i in imoveis if i["parceiro"]]
        lado = ""
        if negocio:
            lado = " para locação" if negocio == "locacao" else " para venda"
        detalhe = ""
        if fora:
            detalhe = " (fora do site: " + ", ".join(fora[:8]) + ")"
        elif parc:
            detalhe = " (só de parceiro: " + ", ".join(parc[:8]) + ")"
        return (f"não tenho imóvel no ar do {', '.join(nomes)}{lado}{detalhe}. "
                "não postei nada.")

    linhas, pares = _opcoes_dos_candidatos(nossos, negocio)
    if not pares:
        return (f"não tenho imóvel no ar do {', '.join(nomes)} desse lado. "
                "não postei nada.")

    # UMA OPÇÃO SÓ E O NEGÓCIO JÁ DITO: não tem o que perguntar.
    if len(pares) == 1 and negocio:
        codigo, lado = pares[0]
        return _postar_agora([codigo], conn, lado)

    trocada = _abrir_pergunta_do_posta(
        conn, ", ".join(nomes), [f"{c}:{lado}" for c, lado in pares], negocio)
    aviso = "(a pergunta anterior eu descartei)\n\n" if trocada else ""

    if len(pares) == 1:
        codigo, lado = pares[0]
        lado_txt = "LOCAÇÃO" if lado == "locacao" else "VENDA"
        return (f"{aviso}achei um só no {', '.join(nomes)}:\n\n{linhas[0]}\n\n"
                f"posto para {lado_txt}? me responde \"{lado_txt.lower()}\" "
                f"ou \"{codigo}\". não postei nada ainda.")

    corpo = "\n".join(linhas)
    return (f"{aviso}o {', '.join(nomes)} tem {len(pares)} opções no ar:\n\n"
            f"{corpo}\n\nqual delas? me responde com o código ou com o valor "
            "(ou \"locação\"/\"venda\", se for isso que decide). "
            "não postei nada ainda.")


def _linhas_das_opcoes(conn, pares):
    """As mesmas linhas da primeira pergunta, para os pares que sobraram."""
    codigos = sorted({c for c, _ in pares})
    with conn.cursor() as cur:
        cur.execute(
            "SELECT i.codigo::text AS codigo, "
            "       nay_linha_da_lista(i.codigo::text, "
            "         nay_categoria_do_imovel(i.tipo, i.condominio_nome), 'locacao') AS linha_locacao, "
            "       nay_linha_da_lista(i.codigo::text, "
            "         nay_categoria_do_imovel(i.tipo, i.condominio_nome), 'venda') AS linha_venda "
            "  FROM imoveis i WHERE i.codigo::text = ANY(%s)", (codigos,))
        por_codigo = {l["codigo"]: l for l in cur.fetchall()}
    linhas = []
    for c, lado in pares:
        im = por_codigo.get(c)
        if im:
            linhas.append(_linha_da_opcao(dict(im, codigo=c), lado))
    return linhas


def _pergunta_do_posta_aberta(conn):
    """A pergunta do `posta <nome>` que está esperando resposta, dentro da
    janela de `pergunta_ao_tel_minutos`. Fora da janela não vale: um "locação"
    de hoje respondendo pergunta de ontem postaria o imóvel errado."""
    with conn.cursor() as cur:
        cur.execute(
            "SELECT id, nome, candidatos, negocio FROM pergunta_ao_tel "
            " WHERE respondida_em IS NULL AND acao = 'postar_por_nome' "
            "   AND criada_em > now() - (coalesce((SELECT valor FROM config "
            "         WHERE chave = 'pergunta_ao_tel_minutos'),'30') || ' minutes')::interval "
            " ORDER BY id DESC LIMIT 1")
        return cur.fetchone()


def _fechar_pergunta_do_posta(conn, id_pergunta, resposta):
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE pergunta_ao_tel SET respondida_em = now(), resposta = %s "
            " WHERE id = %s AND respondida_em IS NULL RETURNING id",
            (resposta, id_pergunta))
        tomou = cur.fetchone()
    conn.commit()
    # TOMA A PERGUNTA NUM UPDATE SÓ: ele repete "locação" achando que não
    # pegou, e a segunda vez não acha mais linha aberta -- em vez de postar
    # duas vezes nos 14 grupos.
    return bool(tomou)


def _valor_da_opcao(conn, codigo, lado):
    """Quanto a opção custa, no mesmo número que a linha da lista mostra --
    para locação isso é o CUSTO CHEIO (com a taxa por fora somada)."""
    with conn.cursor() as cur:
        if lado == "venda":
            cur.execute("SELECT valor_venda AS v FROM imoveis WHERE codigo::text = %s",
                        (codigo,))
        else:
            cur.execute(
                "SELECT nay_custo_cheio(%s,'locacao') AS v, valor_aluguel AS bruto "
                "  FROM imoveis WHERE codigo::text = %s", (codigo, codigo))
        linha = cur.fetchone() or {}
    return [x for x in (linha.get("v"), linha.get("bruto")) if x is not None]


def _escolha_do_posta(comando, conn):
    """"locação", "5725", "3.6k" -- ele escolhendo o que ela ofereceu.

    O PEDIDO (Tel, 15/09): *"se estiver mais de uma opção ela vai me mandar o
    jardim das cerejeiras com o valor e código para eu decidir e respondo com
    ela pelo valor ou código que ela me enviou"*.

    SÓ POSTA O QUE ELA OFERECEU: a resposta escolhe DENTRO de `candidatos`.
    Um código que não estava na pergunta não posta nada -- ele pode estar
    falando de outro imóvel, e postagem em 14 grupos não desfaz.
    """
    pergunta = _pergunta_do_posta_aberta(conn)
    if not pergunta:
        return ("não tenho nenhuma pergunta minha esperando resposta agora. "
                "não postei nada.")

    pares = [tuple(c.split(":", 1)) for c in (pergunta["candidatos"] or [])
             if ":" in c]
    negocio = comando.get("negocio")
    codigo = comando.get("codigo")
    valor = comando.get("valor")

    if negocio:
        restantes = [p for p in pares if p[1] == negocio]
        lado_txt = "locação" if negocio == "locacao" else "venda"
        if not restantes:
            return (f"não tenho opção de {lado_txt} no {pergunta['nome']}. "
                    "não postei nada.")
    else:
        restantes = [p for p in pares if p[0] == codigo] if codigo else []
        # NÚMERO PODE SER CÓDIGO OU VALOR, e nesta ordem: ela imprime o código
        # na frente de cada opção, mas o valor está na mesma linha e ele
        # escreve "3600" onde ela escreveu "3.6k".
        if not restantes:
            alvo = valor_escrito(conn, valor or codigo or "")
            if alvo is not None:
                restantes = [p for p in pares
                             if any(abs(float(v) - float(alvo)) < 0.01
                                    for v in _valor_da_opcao(conn, p[0], p[1]))]
        if not restantes:
            if codigo:
                return (f"o {codigo} não estava nas opções que eu te mandei. "
                        "me responde com um dos códigos da lista. não postei nada.")
            return (f"nenhuma das opções que eu te mandei custa {valor}. "
                    "me responde com o código. não postei nada.")

    if len(restantes) > 1:
        # AINDA FALTA ESCOLHER: refaz a pergunta com o que sobrou, sem postar.
        # É o caso de "locação" quando há dois imóveis de locação no mesmo
        # condomínio -- a resposta estreitou, não resolveu.
        with conn.cursor() as cur:
            cur.execute(
                "UPDATE pergunta_ao_tel SET candidatos = %s, negocio = %s "
                " WHERE id = %s",
                ([f"{c}:{l}" for c, l in restantes], negocio, pergunta["id"]))
        conn.commit()
        linhas = _linhas_das_opcoes(conn, restantes)
        return (f"ficaram {len(restantes)} opções:\n\n" + "\n".join(linhas)
                + "\n\nme responde com o código. não postei nada ainda.")

    codigo, lado = restantes[0]
    if not _fechar_pergunta_do_posta(conn, pergunta["id"], comando.get("texto")):
        return "essa pergunta já tinha sido respondida. não postei de novo."
    return _postar_agora([codigo], conn, lado)


def _criar_vaga(comando, conn):
    with conn.cursor() as cur:
        cur.execute(
            "INSERT INTO vagas (horario, tipo_recorrencia, dias_semana, data_unica, codigos) "
            "VALUES (%s, %s, %s, %s, %s) RETURNING id",
            (
                comando["horario"],
                comando["tipo_recorrencia"],
                comando.get("dias_semana"),
                comando.get("data_unica"),
                comando["codigos"],
            ),
