def _imoveis_da_linha(conn, linha):
    """De que imoveis esta linha fala. A regra mora em `envio_por_descricao.sql`.

    FAIXA 5 NAO ENTRA: ali o nome so se PARECE com o do cadastro, e dali sai
    "voce quis dizer?", nunca afirmacao -- a mesma parede do
    `nay_disponibilidade_no_condominio`. Aqui seria pior que la: afirmar manda
    a carteira para o corretor, e envio de WhatsApp nao desfaz.
    """
    with conn.cursor() as cur:
        cur.execute(
            "SELECT codigo, faixa, negocio, no_mercado "
            "  FROM nay_imoveis_da_linha(%s) WHERE faixa < 5 ORDER BY codigo",
            (linha,))
        return cur.fetchall()


def _envio_pendente_aberto(conn):
    """O envio que ficou esperando a resposta dele, se ainda vale.

    FALHA FECHADA por construcao: sem linha aberta devolve None, e quem
    chama recusa com o comando pronto. A janela vem de
    `config.envio_pendente_minutos` -- estado sem prazo vira resposta errada
    dias depois, e a carteira iria para o corretor da lista ANTERIOR.
    """
    with conn.cursor() as cur:
        cur.execute(
            "SELECT e.* FROM envio_pendente e "
            " WHERE e.fechado_em IS NULL "
            "   AND e.criado_em > now() - (coalesce((SELECT valor FROM config "
            "         WHERE chave = 'envio_pendente_minutos'),'60') || ' minutes')"
            "       ::interval "
            " ORDER BY e.id DESC LIMIT 1")
        return cur.fetchone()


def _fechar_envio_pendente(conn, motivo):
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE envio_pendente SET fechado_em = now(), fechado_motivo = %s "
            " WHERE fechado_em IS NULL", (motivo,))
    conn.commit()


def _resolver_as_linhas(conn, linhas):
    """Cada linha colada vira codigo, pergunta, ou recusa dita.

    LINHA REPETIDA NAO E ENGANO. A colagem do Tel em 11/09 trazia
    "Estilo Golf / 2 quartos sendo 1 suite / 2.6k" DUAS VEZES, e o catalogo
    tem exatamente dois imoveis assim (5719 e 5728) -- porque
    `nay_linha_da_lista` nao e injetora. Deduplicar por texto entregaria um
    imovel e esconderia o outro. Entao a contagem vai junto, e a decisao
    dele (11/09) foi perguntar uma vez e aceitar os dois codigos.
    """
    contagem = {}
    for linha in linhas:
        # O TÍTULO NÃO É IMÓVEL. Desde 15/09 a lista sai com "🔥 ... 🔥" em cima
        # e ele cola a mensagem inteira; sem pular, a resposta traria "não achei
        # imóvel para: 🔥 APARTAMENTOS PARA LOCAÇÃO...". A regra de o que é
        # título mora em `pedido_de_imoveis.e_titulo_ou_recado` -- uma só, a
        # mesma que lê a lista colada pelo corretor.
        if e_titulo_ou_recado(linha):
            continue
        contagem[linha] = contagem.get(linha, 0) + 1

    codigos, ambiguas, sem_casar, fora = [], [], [], []
    for linha, vezes in contagem.items():
        # SÓ A LINHA NO FORMATO DA LISTA DELA ("nome / quartos / valor") passa
        # pelo casamento reverso. Frase DESCRITA vai direto ao leitor de pedido.
        # Medido na prova de 14/09: "o acquarelle de 3 quartos para locação"
        # passava primeiro por `nay_imoveis_da_linha`, que não lê negócio nem a
        # política de oferta, e devolvia CINCO candidatos -- três de venda e
        # dois de parceiro fora do site. O certo era um só, o 5611.
        achados = _imoveis_da_linha(conn, linha) if " / " in linha else []
        if not achados:
            # NÃO É LINHA DA LISTA DELA -- é pedido DESCRITO: "os dois
            # acquarelle de 2 e 3 quartos para locação", "a casa do morada do
            # pássaros" (Tel, 14/09). `imoveis_do_pedido` lê condomínio,
            # categoria, quartos, negócio e valor, sempre na política da lista
            # oficial (nosso e no ar).
            pedido = imoveis_do_pedido(conn, linha)
            if pedido["tipo"] == "ignorar":
                continue
            if pedido["tipo"] == "nada":
                sem_casar.append(pedido.get("motivo") or linha)
            elif pedido["tipo"] == "codigos":
                codigos.extend(c for c in pedido["codigos"] if c not in codigos)
            else:
                ambiguas.append({"linha": linha, "vezes": vezes,
                                 "candidatos": pedido["codigos"],
                                 "descricoes": pedido.get("descricoes") or {}})
            continue
        if len(achados) == 1:
            unico = achados[0]
            # Reconhecer o imovel e poder envia-lo sao decisoes diferentes.
            # Recusa DIZENDO qual: sumico calado foi o que escondeu 112
            # apartamentos de venda em 09/09, e quem tira imovel do site e
            # ele -- a decisao de mandar assim mesmo e dele, nao minha.
            if not unico["no_mercado"]:
                fora.append((unico["codigo"], linha))
            elif unico["codigo"] not in codigos:
                codigos.append(unico["codigo"])
            continue
        ambiguas.append({"linha": linha, "vezes": vezes,
                         "candidatos": [a["codigo"] for a in achados]})
    return codigos, ambiguas, sem_casar, fora


def _frase_das_pendencias(ambiguas, sem_casar, fora):
    """O que ela diz quando nao pode mandar ainda.

    NUNCA escreve "Codigo: NNNN". O no `Achar codigo na resposta` do n8n roda
    /C[oo]digo:\\s*(\\d{3,5})/gi na resposta DELA e, se casar, busca as fotos
    e manda -- para o chat do proprio Tel. Medido: link puro nao dispara, e
    "Codigo: 5719" dispara. Por isso aqui vai o link e o numero solto.
    """
    partes = []
    # UMA LINHA POR VEZ. Com duas linhas em aberto, TODA resposta curta dele
    # ("os dois", "o primeiro") e ambigua -- dois de qual linha? E como nada
    # sai antes da lista inteira fechar (decisao dele em 11/09), perguntar uma
    # por vez nao custa nada e faz a resposta curta sempre ter um referente so.
    if ambiguas:
        a = ambiguas[0]
        cabeca = (f'tenho {len(a["candidatos"])} que servem para:'
                  if a.get("descricoes") else
                  f'tenho {len(a["candidatos"])} iguais nesta linha:'
                  if a["vezes"] == 1 else
                  f'esta linha veio {a["vezes"]}x e tenho '
                  f'{len(a["candidatos"])} iguais:')
        # NUMERADAS, porque senao "o primeiro" e um ordinal contra uma lista
        # que nao tem ordem escrita -- chute com cara de escolha.
        descricoes = a.get("descricoes") or {}
        opcoes = "\n".join(
            f"{i}) {LINK_DO_ANUNCIO}{c}"
            + (f" -- {descricoes[c]}" if descricoes.get(c) else "")
            for i, c in enumerate(a["candidatos"], 1))
        partes.append(cabeca + "\n" + a["linha"] + "\n" + opcoes)
        if len(ambiguas) > 1:
            partes.append(f"(depois desta ainda tenho {len(ambiguas) - 1} "
                          "linha(s) para resolver)")
    if ambiguas:
        # A PERGUNTA TEM QUE ENSINAR UMA RESPOSTA QUE EU LEIA -- a licao de
        # 12/09. A versao anterior dizia 'ou os dois: "Nay codigo 5719 e
        # 5728"', ele respondeu **"os dois"** (a frase que a propria pergunta
        # sugeria) e caiu no AGENTE, que devolveu uma lista sem nexo.
        #
        # Agora a forma natural vem PRIMEIRO e e a mais curta: ela funciona, e
        # e a que ele vai escrever de qualquer jeito.
        primeiro = ambiguas[0]["candidatos"][0]
        if len(ambiguas[0]["candidatos"]) == 2:
            partes.append('quais? responde "os dois" -- ou, para um so, '
                          f'"o primeiro" ou "codigo {primeiro}"')
        else:
            partes.append('quais? responde "todos" -- ou, para um so, '
                          f'"o primeiro" ou "codigo {primeiro}"')
    if fora:
        partes.append("saiu do site, NAO vou mandar:\n"
                      + "\n".join(f"{c} — {l}" for c, l in fora))
    if sem_casar:
        partes.append("nao achei imovel para:\n" + "\n".join(sem_casar))
    return "\n\n".join(partes)


def _parecidos_com(conn, texto):
    """" você quis dizer X?" -- o que o catálogo tem de parecido, ou nada."""
    try:
        with conn.cursor() as cur:
            cur.execute("SELECT nay_normalizar_lugar(%s, true) AS frase", (texto,))
            frase = ((cur.fetchone() or {}).get("frase") or texto)
        nomes = condominios_parecidos(frase, condominios_do_catalogo(conn))
    except Exception:
        return ""
    if not nomes:
        return ""
    return "\n\nvocê quis dizer " + ", ".join(nomes) + "?"


def _envio_sem_destino(comando, conn):
    """Ele descreveu o imóvel e esqueceu para quem (15/09).

    Literal dele, sem destinatário nenhum:

        Nay envia casa para venda em condomínio de 250 mil a 600 mil nos
        bairros parque dez, flores e compensa

    O QUE ACONTECIA ANTES: o único "para" da frase era o de "para venda", e a
    Nay saía procurando um corretor chamado "venda em condomínio de 250 mil a
    600 mil nos bairros...". A resposta era sobre corretor -- ele não teria
    como saber que o pedido em si tinha sido entendido.

    ENTÃO ELA MOSTRA O QUE ACHOU E DEVOLVE A FRASE PRONTA, com o destino no
    fim. Não manda nada: sem destinatário não há o que mandar, e adivinhar
    para quem é o pior erro possível neste projeto.
    """
    pedido = (comando.get("pedido") or "").strip()
    texto = (comando.get("texto") or "").strip()
    achado = imoveis_do_pedido(conn, pedido) if pedido else {"tipo": "ignorar"}

    if achado["tipo"] in ("codigos", "ambiguo"):
        codigos = achado["codigos"]
        quantos = (f"{len(codigos)} imóveis ({', '.join(codigos[:LIMITE_POR_ENVIO])}"
                   + (", ..." if len(codigos) > LIMITE_POR_ENVIO else "") + ")"
                   if len(codigos) > 1 else f"1 imóvel (o {codigos[0]})")
        cabeca = f"esse pedido dá {quantos}, mas você não disse para quem."
        # O TETO POR LEVA JÁ AVISA AQUI. Sem isto ele manda de novo com o
        # destinatário só para ouvir que são imóveis demais -- duas idas e
        # voltas para a mesma informação que eu já tenho na mão.
        if len(codigos) > LIMITE_POR_ENVIO:
            cabeca += (f" e é muito para uma leva só (o limite é "
                       f"{LIMITE_POR_ENVIO}): estreita com bairro, quartos ou "
                       "uma faixa de valor menor.")
    elif achado["tipo"] == "nada":
        cabeca = ("não achei imóvel para " + achado["motivo"]
                  + _parecidos_com(conn, pedido)
                  + "\n\n(e também faltou dizer para quem mandar.)")
    else:
        cabeca = ("entendi que é para enviar imóvel, mas não achei o imóvel "
                  "nem o destinatário." + _parecidos_com(conn, pedido))

    return (cabeca + "\n\nme manda de novo com o destino no fim -- o número "
            "do corretor, o nome dele, ou os dois:\n\n"
            + texto + " para 92 9999-9999\n\nnão mandei nada.")


def _enviar_lista_para_corretor(comando, conn):
    """A lista colada: descobre os codigos e manda -- ou pergunta primeiro.

    O PEDIDO (Tel, 11/09), literal:

        Nay envia esses imoveis para o numero 92994717316
        Arezzo Residencial / 2 quartos / 2.5k
        Ariranhas / 2 quartos / 2.6k (incluso a tx)
        Estilo Golf / 2 quartos sendo 1 suite / 2.6k
        Estilo Golf / 2 quartos sendo 1 suite / 2.6k

    SEGURA TUDO ATE ELE RESPONDER -- decisao dele em 11/09, para o corretor
    receber uma leva so em vez de duas. E por isso o estado guarda o envio
    COMPLETO: destinatario e tudo que ja resolveu.
    """
    telefone, nome, aviso_cadastro = _destinatario(conn, comando)
    if telefone is None:
        return nome  # aqui `nome` carrega o motivo da recusa

    codigos, ambiguas, sem_casar, fora = _resolver_as_linhas(
        conn, comando["linhas"])

    # TETO POR LEVA. "todos os apartamentos de venda" são centenas, e cada um
    # leva ~1 minuto com fotos -- o corretor recebe por horas e ninguém lê.
    # Acima do teto não sai nada: ela diz quantos são e pede para estreitar.
    if len(codigos) > LIMITE_POR_ENVIO:
        return (f"esse pedido dá {len(codigos)} imóveis para {nome} -- é muito "
                f"para mandar de uma vez (o limite é {LIMITE_POR_ENVIO}). me manda "
                "de novo com um teto de valor, o bairro ou os quartos. "
                "nao mandei nada.")

    if not codigos and not ambiguas:
        # "dessa lista" só quando é lista mesmo. O pedido DESCRITO entra aqui
        # como uma linha só, e dizer "lista" para quem escreveu uma frase
        # confunde -- foi o que o Tel leu em 15/09.
        e_lista = len(comando["linhas"]) > 1 or any(
            " / " in l for l in comando["linhas"])
        o_que = "nenhum imovel dessa lista" if e_lista else "nenhum imovel assim"
        # E DIZ O QUE EXISTE DE PARECIDO (15/09). "envia o vista dos cedros"
        # morria em "não consegui identificar nenhum imóvel assim" -- o imóvel
        # estava no ar, o cadastro é que escreve "Vistas dos Cedros". Recusa
        # que não ensina faz ele tentar de novo às cegas.
        parecidos = ""
        if not e_lista:
            parecidos = _parecidos_com(conn, comando["linhas"][0])
        return (f"nao consegui identificar {o_que} para {nome}. "
                "nao mandei nada." + parecidos + "\n\n"
                + _frase_das_pendencias([], sem_casar, fora))

    # Lista nova fecha a anterior: com duas em aberto, "Nay codigo 5719" seria
    # ambiguo e ela aplicaria a pergunta errada -- mandando a carteira para o
    # corretor da lista passada. O indice unico garante uma so.
    anterior = _envio_pendente_aberto(conn)
    _fechar_envio_pendente(conn, "trocado")

    if not ambiguas:
        resposta = _mandar_os_codigos(conn, telefone, nome, codigos)
        rabo = _frase_das_pendencias([], sem_casar, fora)
        return aviso_cadastro + resposta + ("\n\n" + rabo if rabo else "")

    with conn.cursor() as cur:
        cur.execute(
            "INSERT INTO envio_pendente (destino_telefone, destino_nome, "
            "  codigos, ambiguas, sem_casar, fora_do_site) "
            "VALUES (%s,%s,%s,%s::jsonb,%s,%s)",
            (telefone, nome, codigos, json.dumps(ambiguas, ensure_ascii=False),
             sem_casar, [c for c, _ in fora]))
    conn.commit()

    aviso = aviso_cadastro + (
        "(a lista anterior que estava em aberto eu descartei)\n\n"
        if anterior else "")
    return (f"{aviso}nao mandei nada ainda para {nome} -- resolvo a lista inteira "
            f"e mando de uma vez.\n\n"
            + _frase_das_pendencias(ambiguas, sem_casar, fora))


def _codigos_da_escolha(comando, ambiguas):
    """Traduz "os dois" / "ambos" / "o primeiro" nos codigos de verdade.

    O PARSER NAO PODE FAZER ISSO. Ele nao conhece os candidatos -- quem tem a
    lista em aberto na mao e aqui. Devolve (codigos, motivo_da_recusa): com
    motivo preenchido, NAO ENVIA.

    FALHA FECHADA em toda duvida. "os dois" com duas linhas ambiguas em aberto
    e dois de QUAL linha? Nao se adivinha: envio de WhatsApp nao desfaz.
    """
    if comando.get("codigos"):
        return comando["codigos"], None

    todos = [c for a in ambiguas for c in a["candidatos"]]

    # "ambos", "todos", "tudo" -- tudo que ela ofereceu, de todas as linhas.
    if comando.get("todos"):
        return todos, None

    # A PERGUNTA MOSTRA UMA LINHA POR VEZ, entao "os dois" e "o primeiro" tem
    # um referente so: a linha que ela acabou de mostrar. Foi o que consertou a
    # ambiguidade de raiz -- antes, com duas linhas em aberto, toda resposta
    # curta dele era ambigua e a unica saida era recusar.
    aqui = ambiguas[0]["candidatos"]

    quantos = comando.get("quantos")
    if quantos:
        # A CONTA TEM QUE FECHAR. "os dois" com tres candidatos nao e escolha,
        # e uma frase que nao cabe -- e escolher dois dos tres seria eu
        # inventando quais.
        if len(aqui) == quantos:
            return aqui, None
        return [], (f"você disse {quantos}, mas nesta linha são {len(aqui)}. "
                    'me manda o código, ou "todos".')

    posicao = comando.get("posicao")
    if posicao:
        if posicao == -1:
            return [aqui[-1]], None
        if posicao > len(aqui):
            return [], (f"só tenho {len(aqui)} nesta linha. me manda o código.")
        return [aqui[posicao - 1]], None

    return [], None


def _escolher_codigos(comando, conn):
    """"Nay codigo 5719" -- ele desempatando, e o envio saindo inteiro.

    O PORTAO FALHA FECHADO: so envia se houver envio em aberto, dentro da
    janela, E se os codigos que ele deu forem candidatos de verdade daquela
    lista. Sem isso, "Nay codigo 5719" depois de a janela vencer mandaria a
    carteira para o corretor da lista ANTERIOR -- e este projeto trata
    "atender uma pessoa achando que e outra" como o pior resultado possivel.
    """
    pendente = _envio_pendente_aberto(conn)
    if not pendente:
        # "NAY CODIGO 5725" TAMBEM RESPONDE A PERGUNTA DO `posta <nome>`
        # (15/09). Sao duas perguntas diferentes que aceitam a mesma frase;
        # se nao ha lista de envio em aberto e ha uma pergunta de postagem,
        # ele so pode estar respondendo esta. Com as DUAS abertas quem manda e
        # a lista de envio, que ja era dona desta frase.
        um = (comando.get("codigos") or [None])[0]
        if um and _pergunta_do_posta_aberta(conn):
            return _escolha_do_posta({"codigo": um, "texto": comando.get("texto")},
                                     conn)
        # A recusa carrega o comando PRONTO, que e o padrao do projeto para
        # quando falta contexto (`_perguntar_o_negocio`, a trava de lista, o
        # DESCARTAR TUDO SIM): a resposta dele volta auto-contida.
        if um:
            return ("nao tenho nenhuma lista esperando resposta agora. se e para "
                    f"mandar o {um}, me diz para quem: "
                    f'"Nay envia o {um} para <nome ou numero>". nao mandei nada.')
        # "os dois" sem lista em aberto nao diz NADA sobre qual imovel --
        # nem sequer da para oferecer o comando pronto.
        return ("nao tenho nenhuma lista esperando resposta agora, entao nao sei "
                "de quais imoveis voce falou. me manda a lista de novo, ou "
                '"Nay envia o <codigo> para <nome ou numero>". nao mandei nada.')

    ambiguas = pendente["ambiguas"] or []
    if isinstance(ambiguas, str):
        ambiguas = json.loads(ambiguas)

    escolhidos, recusa = _codigos_da_escolha(comando, ambiguas)
    if recusa:
        return recusa + "\n\n" + _frase_das_pendencias(ambiguas, [], [])
    if not escolhidos:
        return ("nao entendi qual voce quer. nao mandei nada.\n\n"
                + _frase_das_pendencias(ambiguas, [], []))

    de_verdade = {c for a in ambiguas for c in a["candidatos"]}
    intrusos = [c for c in escolhidos if c not in de_verdade]
    aceitos = [c for c in escolhidos if c in de_verdade]

    if not aceitos:
        return ("esse codigo nao esta entre os que eu te ofereci. nao mandei "
                "nada.\n\n"
                + _frase_das_pendencias(ambiguas, [], []))

    # Linha resolvida e a que teve ALGUM candidato escolhido. O que sobrar
    # continua pendurado: nada sai enquanto a lista inteira nao fechar, que
    # foi a decisao dele.
    sobraram = [a for a in ambiguas
                if not any(c in aceitos for c in a["candidatos"])]

    codigos = list(dict.fromkeys((pendente["codigos"] or []) + aceitos))

    if sobraram:
        with conn.cursor() as cur:
            cur.execute(
                "UPDATE envio_pendente SET codigos = %s, ambiguas = %s::jsonb "
                " WHERE id = %s",
                (codigos, json.dumps(sobraram, ensure_ascii=False),
                 pendente["id"]))
        conn.commit()
        aviso = (f"o {', '.join(intrusos)} nao estava na lista, ignorei.\n\n"
                 if intrusos else "")
        return (aviso + "anotei. ainda falta resolver:\n\n"
                + _frase_das_pendencias(sobraram, [], []))

    _fechar_envio_pendente(conn, "enviado")
    resposta = _mandar_os_codigos(conn, pendente["destino_telefone"],
                                  pendente["destino_nome"], codigos)
    rabo = _frase_das_pendencias(
        [], pendente["sem_casar"] or [],
        [(c, "") for c in (pendente["fora_do_site"] or [])])
    aviso = (f"o {', '.join(intrusos)} nao estava na lista, ignorei.\n\n"
             if intrusos else "")
    return aviso + resposta + ("\n\n" + rabo if rabo else "")


def _registrar_envio_corretor(conn, codigo, telefone, message_id=None):
    """Deixa rastro em `envios`, como o disparo de grupo passou a fazer.

    GUARDA O message_id (01/09): quando o corretor marca este card, a
    Z-API manda o ID dele em `referenceMessageId`, e `nay_imovel_da_citacao`
    devolve o código por igualdade. Sem o ID guardado, a Nay só pode
    perguntar de qual imóvel se trata.

    Nunca derruba: a mensagem ja saiu quando isto roda.
    """
    try:
        with conn.cursor() as cur:
            cur.execute(
                "INSERT INTO envios (codigo, telefone, destino, message_id) "
                "VALUES (%s,%s,'corretor',%s)",
                (str(codigo), str(telefone), message_id),
            )
        conn.commit()
    except Exception:
        try:
            conn.rollback()
        except Exception:
            pass


def _fotos_para_grupo(imovel, grupo):
    """9 dos 10 grupos recebem só a capa (1a foto); só o grupo com
    todas_fotos=true recebe a lista inteira (decisão do Tel)."""
    fotos = imovel["fotos"]
    if grupo.get("todas_fotos"):
        return fotos
    return fotos[:1]


def _avisos_dados_incompletos(imovel):
    """area==0 ou vagas==0 é dado provavelmente incompleto na extração,
    não motivo pra recusar o post -- só um aviso separado pro Tel
    confirmar com o proprietário."""
    avisos = []
    if imovel.get("area") == 0:
        avisos.append(
            f"Aviso: o imóvel {imovel['codigo']} está com metragem zerada -- "
            "confirme com o proprietário."
        )
    if imovel.get("vagas") == 0:
        avisos.append(
            f"Aviso: o imóvel {imovel['codigo']} está com vagas zeradas -- "
            "confirme com o proprietário."
        )

    # A TAXA QUE NINGUÉM MARCOU. O Tel reclamou em 14/09 que o card do 5718
    # saiu sem "(incluso a tx)". A regra funcionava -- provado no 3714, que
    # tem a marca e sai com o sufixo; o que faltava era o DADO. Medido no
    # mesmo dia: **50 dos 85 imóveis de locação no mercado não têm nenhuma
    # informação de taxa**, e o site não publica o campo em lugar nenhum.
    #
    # Então o aviso fecha o laço: ele já recebe esta confirmação a cada
    # disparo, e a frase traz o comando pronto. Uma linha por disparo enche a
    # lacuna com o tempo, em vez de exigir que ele repasse 50 imóveis.
    #
    # Só quando NÃO SE SABE. Taxa inclusa marcada e taxa por fora com valor
    # são as duas informações -- avisar sobre elas seria cobrar o que já está
    # respondido.
    tem_aluguel = (imovel.get("valor_aluguel") or 0) > 0
    incluso = (imovel.get("incluso_no_aluguel") or "")
    taxa_por_fora = (imovel.get("taxa_condominio") or 0) > 0
    if tem_aluguel and "condom" not in incluso.lower() and not taxa_por_fora:
        avisos.append(
            f"Aviso: não sei se a taxa de condomínio está inclusa no aluguel "
            f"do {imovel['codigo']}, então o card saiu sem \"(incluso a tx)\". "
            f"Se está inclusa, me manda: {imovel['codigo']} incluso a tx"
        )
    return avisos


def _registrar_publicacao(conn, codigo, grupo, message_id=None):
    """Anota que este código foi para este grupo, agora.

    POR QUE ISSO EXISTE (31/08): o corretor responde ao card do grupo
    perguntando "esse está 100% mobiliado?" -- e não havia como saber de
    qual imóvel ele falava. A Z-API não manda mensagem citada (conferido
