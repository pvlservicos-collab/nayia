#!/usr/bin/env python3
"""claude-agente: roda UM pedido do Agente Claude NESTE servidor, como root. Fica em /usr/local/sbin nas duas VPS.

Recebe no stdin {"mensagem", "modelo", "sistema"?, "esforco"?, "modo", "timeout_s"} e devolve no stdout o JSON do
`claude -p`. O agente.py da VPS2 chama este arquivo direto (servidor vps2) ou por ssh (servidor vps1).

- modo "responder": sem ferramentas, numa pasta vazia; só devolve texto.
- modo "projeto" (20/10, os chats do painel): a pasta do projeto (CLAUDE.md com o contexto), as ferramentas de
  LEITURA do mcp_leitura.py (banco naydb/crmdb e códigos das duas VPS) e, para consertar bug quando pedirem (Pedro,
  20/10: "deixa o root para esses terminais caso eles precisem consertar um bug"), terminal e edição como root em
  todo o disco (--add-dir /; a VPS1 pelo ssh). --session-id na primeira mensagem e --resume nas outras.
- modo "alterar" (Pedro, 20/10/2026: "esse claude fazer alterações que eu mandar", "tudo, como root"): terminal,
  edição de arquivo e web liberados, trabalhando em /root. A sessão fica guardada em /root/.claude/projects para
  se poder ler depois o que ele fez (o id vai para metricas.db).

Login: CLAUDE_CODE_OAUTH_TOKEN de /etc/agente-claude/claude.env (claude setup-token); sem ele, vale o /login feito
no `claude` do root deste servidor. Com "conta": "api" no pedido (23/10, o botão do painel, conta.py), roda pela
ANTHROPIC_API_KEY de /etc/agente-claude/api.env, sem o token da assinatura, e com --max-budget-usd = "max_usd".
"""
import json, os, socket, subprocess, sys

CLAUDE = "/root/.local/bin/claude"
LOGIN = "/etc/agente-claude/claude.env"
CHAVE_API = "/etc/agente-claude/api.env"
VAZIO = "/var/lib/agente-claude/vazio"
PROJETOS = "/opt/agente-claude/projetos"
FERRAMENTAS = "Bash,Edit,Write,Read,Glob,Grep,NotebookEdit,WebFetch,WebSearch,TodoWrite"
# o MCP de leitura dos projetos (só na VPS2, onde estão o painel e o Python do Hermes, que tem o pacote mcp)
LEITURA = {"mcpServers": {"leitura": {"command": "/usr/local/lib/hermes-agent/venv/bin/python",
                                      "args": ["/opt/agente-claude/mcp_leitura.py"]}}}
FERRAMENTAS_LEITURA = ",".join("mcp__leitura__" + f for f in ("consultar_banco", "ler_arquivo", "listar", "procurar"))

p = json.load(sys.stdin)
env = {**os.environ, "HOME": "/root", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1", "DISABLE_AUTOUPDATER": "1"}
api = p.get("conta") == "api"
for k in ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"):
    env.pop(k, None)
arquivo = CHAVE_API if api else LOGIN
if os.path.exists(arquivo):
    for l in open(arquivo, encoding="utf-8"):
        if "=" in l and not l.lstrip().startswith("#"):
            k, v = l.strip().split("=", 1)
            if v.strip().strip('"'):
                env[k] = v.strip().strip('"')
if api and not env.get("ANTHROPIC_API_KEY"):
    print(json.dumps({"is_error": True, "result": f"modo API sem ANTHROPIC_API_KEY em {CHAVE_API} neste servidor"}))
    sys.exit(1)

cmd = [CLAUDE, "-p", p["mensagem"], "--output-format", "json", "--model", p.get("modelo") or "sonnet",
       "--strict-mcp-config"]
if api and p.get("max_usd") is not None:
    cmd += ["--max-budget-usd", f"{max(0.01, float(p['max_usd'])):.2f}"]
if p.get("esforco"):
    cmd += ["--effort", p["esforco"]]
if p.get("modo") == "projeto":
    # um projeto do painel (projetos.py): lê pelo MCP e, se pedirem conserto, mexe como root; retomando a sessão
    cwd = os.path.realpath(p["pasta"])
    if not cwd.startswith(PROJETOS + "/"):
        print(json.dumps({"is_error": True, "result": "pasta de projeto inválida"}))
        sys.exit(1)
    cmd += ["--mcp-config", json.dumps(LEITURA), "--allowedTools", FERRAMENTAS + "," + FERRAMENTAS_LEITURA,
            "--permission-mode", "acceptEdits", "--add-dir", "/"]
    sessao = ["--session-id", p["sessao"]] if p.get("nova") else ["--resume", p["sessao"]]
elif p.get("modo") == "alterar":
    contexto = (f"Você é o Claude do servidor {socket.gethostname()}, rodando como root sem ninguém olhando: quem "
                "pediu foi o Pedro, pelo Agente Claude, e vai ler só a sua resposta final. Faça a alteração pedida. "
                "No fim, responda em poucas linhas, em português: o que mudou (arquivos, comandos, serviços), "
                "como conferir e como desfazer. Se não deu para fazer, diga o porquê.")
    cmd += ["--allowedTools", FERRAMENTAS, "--permission-mode", "acceptEdits",
            "--append-system-prompt", contexto + ("\n\n" + p["sistema"] if p.get("sistema") else "")]
    cwd = "/root"
else:
    cmd += ["--tools", "", "--no-session-persistence"]
    if p.get("sistema"):
        cmd += ["--system-prompt", p["sistema"]]
    os.makedirs(VAZIO, exist_ok=True)
    cwd = VAZIO


def rodar(extra):
    return subprocess.run(cmd + extra, capture_output=True, text=True, cwd=cwd, env=env,
                          timeout=int(p.get("timeout_s") or 300))


try:
    if p.get("modo") == "projeto":
        r = rodar(sessao)
        # a sessão já nasceu numa tentativa anterior que deu erro depois de criada: segue por ela
        if p.get("nova") and "already in use" in (r.stdout + r.stderr):
            r = rodar(["--resume", p["sessao"]])
    else:
        r = rodar([])
except subprocess.TimeoutExpired:
    print(json.dumps({"is_error": True, "result": f"passou de {p.get('timeout_s')} s"}))
    sys.exit(1)
sys.stdout.write(r.stdout if r.stdout.strip() else json.dumps({"is_error": True, "result": (r.stderr or "").strip()[:2000]}))
sys.exit(r.returncode)
