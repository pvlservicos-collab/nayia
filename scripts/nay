#!/bin/bash
# nay: o caminho curto de toda mudança na Nay. Uso, na raiz do nayia (Git Bash):
#   ANTES DE IR AO SERVIDOR, o que é local (da foto em producao/):
#   ./scripts/nay tabela <nome>                  colunas, índices, permissões por papel, quem escreve nela
#   ./scripts/nay fn <nome>                      o arquivo da função viva, quem a chama, migrações que a citam
#   ./scripts/nay onde <palavra ou frase>        onde aparece: banco, nós do n8n, CRM, site
#   ./scripts/nay q  arquivo.sql|"SELECT ..."   consulta SÓ LEITURA no naydb
#   ./scripts/nay crmq arquivo.sql|"SELECT ..." consulta SÓ LEITURA no banco do CRM (crmdb)
#   ./scripts/nay ensaio migracao.sql [testes.sql]   ensaia a PRÓPRIA migração: o COMMIT vira ROLLBACK; os testes rodam antes
#   ./scripts/nay backup fn1 fn2 ... [rotulo]    pg_get_functiondef para /root/backups-funcoes/<fn>-<data>-<rotulo>.sql
#   ./scripts/nay aplicar arquivo.sql            aplica (o arquivo tem BEGIN/COMMIT), tira a foto e mostra o git status
#   ./scripts/nay bateria                        nai_rodar_casos(): passou/total e as que falharam
#   ./scripts/nay conversa <4 últimos dígitos> [horas]   o que ela e a pessoa disseram (padrão 12 h)
#   ./scripts/nay site                           sobe nay-site-api + arquivos do imob-easy/ e confere /api/imoveis/opcoes
#   ./scripts/nay crm arquivo1 arquivo2 ...      copia para /docker/crm/app e rebuild (~4 min)
# Regras (CLAUDE.md): backup -> ensaio -> aplicar -> foto -> commit. Nunca reaplique .sql antigo.
set -uo pipefail
RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
SRV=nay-srv1894338
PSQL="nay-postgres psql -U nay -d naydb -X -v ON_ERROR_STOP=1 -P pager=off"
cmd="${1:-}"; shift || true
lf() { tr -d '\r'; }   # o Windows grava CRLF; o psql quer LF
case "$cmd" in
  q)
    { if [ -f "${1:-}" ]; then cat "$1"; else printf '%s\n' "$*"; fi; } | lf | ssh -o ConnectTimeout=20 $SRV "docker exec -i -e PGOPTIONS='-c default_transaction_read_only=on -c statement_timeout=60000' nay-postgres psql -U nay -d naydb -X -v ON_ERROR_STOP=1 -P pager=off -A -F' | '" ;;
  ensaio)
    # ENSAIA A PRÓPRIA MIGRAÇÃO (02/10): o arquivo de verdade tem BEGIN ... COMMIT;
    # aqui o COMMIT do fim sai e entra ROLLBACK, sem tocar no arquivo. O segundo
    # argumento, opcional, são os testes que rodam DENTRO da transação, antes do
    # ROLLBACK. Antes era preciso montar uma cópia "_ensaio" à mão a cada vez --
    # e foi a cópia desatualizada que escondeu erro mais de uma vez.
    f="$1"; t="${2:-}"
    [ -f "$f" ] || { echo "não achei $f"; exit 1; }
    [ -z "$t" ] || [ -f "$t" ] || { echo "não achei os testes $t"; exit 1; }
    n=$(grep -ciE '^\s*COMMIT\s*;' "$f" || true)
    if [ "$n" -gt 1 ]; then echo "RECUSADO: $n COMMITs no arquivo; o ensaio só sabe trocar um"; exit 1; fi
    if [ "$n" -eq 0 ] && ! tail -5 "$f" | grep -qi '^ROLLBACK;'; then echo "RECUSADO: sem COMMIT, o arquivo precisa terminar em ROLLBACK;"; exit 1; fi
    if [ -n "$t" ] && grep -qiE '^\s*(COMMIT|BEGIN)\s*;' "$t"; then echo "RECUSADO: os testes não podem ter BEGIN nem COMMIT"; exit 1; fi
    montado=$({ sed -E '/^[[:space:]]*[Cc][Oo][Mm][Mm][Ii][Tt][[:space:]]*;/d' "$f"; [ -z "$t" ] || { echo; cat "$t"; }; [ "$n" -eq 0 ] || { echo; echo "ROLLBACK;"; }; } | lf)
    if printf '%s\n' "$montado" | grep -qiE '^\s*COMMIT\s*;'; then echo "RECUSADO: sobrou COMMIT depois de montar"; exit 1; fi
    printf '%s\n' "$montado" | ssh -o ConnectTimeout=20 $SRV "docker exec -i -e PGOPTIONS='-c statement_timeout=120000 -c lock_timeout=3000' $PSQL" ;;
  crmq)
    # consulta SÓ LEITURA no banco do CRM (crmdb, que mora no mesmo nay-postgres)
    { if [ -f "${1:-}" ]; then cat "$1"; else printf '%s\n' "$*"; fi; } | lf | ssh -o ConnectTimeout=20 $SRV "docker exec -i -e PGOPTIONS='-c default_transaction_read_only=on -c statement_timeout=60000' nay-postgres psql -U nay -d crmdb -X -v ON_ERROR_STOP=1 -P pager=off -A -F' | '" ;;
  tabela)
    # LOCAL, sem servidor: colunas, permissões e quem escreve (da foto)
    for n in "$@"; do
      a=$(ls "$RAIZ/producao/tabelas/" | grep -iE "^(privado\.)?$n\.md$" | head -1)
      [ -n "$a" ] && cat "$RAIZ/producao/tabelas/$a" || { echo "sem tabela '$n' na foto. Parecidas:"; ls "$RAIZ/producao/tabelas/" | grep -i "$n" | sed 's/\.md$//' | head -15; }
    done ;;
  fn)
    # LOCAL: o arquivo da função viva, quem a chama e as últimas migrações que a citam
    n="$1"
    ls "$RAIZ/producao/funcoes/" | grep -iE "^$n\(" | sed "s#^#producao/funcoes/#" || true
    grep -iE "^$n	" "$RAIZ/producao/quem_chama.tsv" | sed 's/	/  <- chamada por: /' || true
    echo "migrações que a citam (as 5 últimas): $(grep -lE "\b$n\b" "$RAIZ"/Arquivos/nai/[0-9]*.sql 2>/dev/null | sed 's#.*/##' | sort -V | tail -5 | tr '\n' ' ')" ;;
  onde)
    # LOCAL: onde uma palavra ou frase aparece em tudo o que roda (banco, n8n, CRM, site)
    # (git grep, e não o grep do Git Bash: aquele aborta com -i em texto com acento)
    git -C "$RAIZ" -c core.quotepath=false grep -nIiF --untracked -- "$*" -- producao crm/src nay-site-api imob-easy/assets/js imob-easy/admin MAPA.md ':!*.json' \
      | cut -c1-220 | head -60 ;;
  backup)
    args=("$@"); rot="${args[-1]}"; unset 'args[-1]'; [ ${#args[@]} -eq 0 ] && { args=("$rot"); rot="manual"; }
    for fn in "${args[@]}"; do
      n=$(echo "$fn" | cut -d'(' -f1)
      ssh -o ConnectTimeout=20 $SRV "docker exec nay-postgres psql -U nay -d naydb -Atc \"SELECT pg_get_functiondef('$fn'::regprocedure)\" > /root/backups-funcoes/$n-$(date +%F)-$rot.sql && echo backup $n ok"
    done ;;
  aplicar)
    f="$1"; lf < "$f" | ssh -o ConnectTimeout=20 $SRV "docker exec -i -e PGOPTIONS='-c statement_timeout=120000 -c lock_timeout=3000' $PSQL" || { echo "FALHOU: nada commitado"; exit 1; }
    "$RAIZ/scripts/foto_producao.sh" 2>/dev/null | tail -1; git -C "$RAIZ" status --short | head -20 ;;
  bateria)
    "$0" q "SELECT count(*) FILTER (WHERE passou) AS passou, count(*) AS total FROM nai_rodar_casos(); SELECT regra, left(frase,60) frase, esperado, deu FROM nai_rodar_casos() WHERE NOT passou;" ;;
  conversa)
    d="$1"; h="${2:-12}"
    "$0" q "SELECT to_char(x.h,'DD HH24:MI') hora, x.quem, x.txt FROM (
      SELECT t.criado_em h, 'ELE' quem, left(regexp_replace(t.texto,'\s+',' ','g'),200) txt FROM nai_turno t JOIN nai_contato k ON k.id=t.contato_id WHERE right(regexp_replace(k.telefone,'\D','','g'),4)='$d' AND t.criado_em>now()-interval '$h hours'
      UNION ALL SELECT s.criado_em, 'NAY '||s.estado||coalesce(':'||s.bloqueio,''), CASE WHEN s.tipo='imagem' THEN '[foto '||s.codigo||']' ELSE left(regexp_replace(s.texto,'\s+',' ','g'),200) END FROM nai_saida s JOIN nai_contato k ON k.id=s.contato_id WHERE right(regexp_replace(k.telefone,'\D','','g'),4)='$d' AND s.criado_em>now()-interval '$h hours' AND s.papel_destino<>'tel') x ORDER BY 1;" ;;
  site)
    # a API são DOIS arquivos: o olx_api.py tinha que ir à mão e era esquecido
    for a in app.py olx_api.py; do
      scp -q "$RAIZ/nay-site-api/$a" $SRV:/docker/nay-site-api/$a || { echo "FALHOU copiar $a"; exit 1; }
    done
    for f in "$@"; do
      ssh -o ConnectTimeout=20 $SRV "cat > '/docker/nay-site-web/public/$f'" < "$RAIZ/imob-easy/$f" || { echo "FALHOU copiar $f"; exit 1; }
    done
    ssh -o ConnectTimeout=20 $SRV 'cd /docker/nay-site-api && docker compose up -d --build 2>&1 | grep -i started | tail -1; sleep 7; curl -s -m 60 -o /dev/null -w "/api/imoveis/opcoes -> %{http_code} em %{time_total}s\n" http://127.0.0.1:8092/api/imoveis/opcoes' ;;
  crm)
    # cria a pasta antes (rota nova mora em pasta nova) e PARA se a cópia falhar:
    # em 30/09 duas rotas novas não subiram e o scp -q engoliu o erro
    for f in "$@"; do
      d="/docker/crm/app/$(dirname "$f")"
      printf '%s' "$d" | ssh -o ConnectTimeout=20 $SRV 'd=$(cat); mkdir -p "$d"' || { echo "FALHOU criar a pasta de $f"; exit 1; }
      ssh -o ConnectTimeout=20 $SRV "cat > '/docker/crm/app/$f'" < "$RAIZ/crm/$f" || { echo "FALHOU copiar $f"; exit 1; }
    done
    ssh -o ConnectTimeout=20 $SRV 'cd /docker/crm && docker compose up -d --build 2>&1 | tail -2; docker ps --filter name=crm-imobeasy --format "{{.Names}} {{.Status}}"' ;;
  *) sed -n 2,17p "$0" ;;
esac
